<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#071a2d' />
    <meta name='color-scheme' content='light' />
    <title>{{meta.title}}</title>
    <meta name='description' content='{{meta.description}}' />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:locale' content='{{localeCode}}' />
    <meta property='og:title' content='{{meta.ogTitle}}' />
    <meta property='og:description' content='{{meta.ogDescription}}' />
    <meta property='og:url' content='https://yourenergy.am{{path}}' />
    <meta property='og:image' content='https://yourenergy.am/images/about-hero-1600.jpg' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content='{{meta.ogTitle}}' />
    <meta name='twitter:description' content='{{meta.ogDescription}}' />
    <meta name='twitter:image' content='https://yourenergy.am/images/about-hero-1600.jpg' />
    <link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' href='/favicon.png' type='image/png' sizes='512x512' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' sizes='180x180' />
    <link rel='stylesheet' href='/src/styles/about.css' />
  </head>
  <body class='page-about' data-about-page>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>
    {{> site-header}}

    <main id='main'>
      <section class='about-hero' aria-labelledby='about-hero-title'>
        <div class='about-hero__media' aria-hidden='true'>
          <picture>
            <source type='image/avif' srcset='/images/about-hero-1024.avif 1024w, /images/about-hero-1600.avif 1600w, /images/about-hero-1920.avif 1920w' sizes='100vw' />
            <source type='image/webp' srcset='/images/about-hero-1024.webp 1024w, /images/about-hero-1600.webp 1600w, /images/about-hero-1920.webp 1920w' sizes='100vw' />
            <img src='/images/about-hero-1600.jpg' width='1600' height='900' alt='' fetchpriority='high' decoding='async' />
          </picture>
        </div>
        <div class='about-hero__veil' aria-hidden='true'></div>
        <div class='container about-hero__layout'>
          <div class='about-hero__copy' data-about-reveal>
            <span class='about-kicker about-hero__kicker'>{{aboutPage.hero.eyebrow}}</span>
            <h1 id='about-hero-title'>{{aboutPage.hero.titleLead}} <mark>{{aboutPage.hero.titleAccent}}</mark></h1>
            <p>{{aboutPage.hero.copy}}</p>
            <div class='about-hero__actions'>
              <a class='button' href='{{calculatorHref}}'>{{aboutPage.finalCta.primary}} <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a>
              <a class='about-hero__text-link' href='{{contactsHref}}'>{{aboutPage.finalCta.secondary}} <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a>
            </div>
            <ul class='about-hero__signals' role='list'>
              {{#each aboutPage.hero.signals}}
                <li>
                  <span class='about-hero__signal-icon'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#{{icon}}'></use></svg></span>
                  <span><strong>{{title}}</strong>&#32;<small>{{copy}}</small></span>
                </li>
              {{/each}}
            </ul>
          </div>
          <aside class='about-hero__route' data-about-reveal aria-labelledby='about-route-title'>
            <div class='about-hero__route-top'>
              <span>{{aboutPage.principles.eyebrow}}</span>
              <span aria-hidden='true'>1 — 4</span>
            </div>
            <h2 id='about-route-title'>{{aboutPage.principles.title}}</h2>
            <ol>
              {{#each aboutPage.principles.items}}
                <li>
                  <span class='about-hero__route-number'>{{add @index 1}}</span>
                  <span><b>{{title}}</b><em>{{copy}}</em></span>
                </li>
              {{/each}}
            </ol>
          </aside>
        </div>
      </section>

      <section class='about-intro about-section' aria-labelledby='about-intro-title'>
        <div class='container about-intro__grid'>
          <div class='about-copy' data-about-reveal>
            <span class='about-kicker'>{{aboutPage.intro.eyebrow}}</span>
            <h2 id='about-intro-title'>{{aboutPage.intro.titleLead}} <mark>{{aboutPage.intro.titleAccent}}</mark></h2>
            <p>{{aboutPage.intro.copy}}</p>
            <p>{{aboutPage.intro.copySecond}}</p>
            <p>{{aboutPage.intro.copyThird}}</p>
          </div>
          <aside class='about-intro__facts' data-about-reveal>
            <div class='about-intro__facts-head'>
              <span class='about-intro__facts-icon'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#sun'></use></svg></span>
              <span>{{aboutPage.intro.factsTitle}}</span>
            </div>
            <dl>
              {{#each aboutPage.intro.facts}}
                <div>
                  <dt>{{label}}</dt>
                  <dd>{{value}}</dd>
                </div>
              {{/each}}
            </dl>
          </aside>
        </div>
      </section>

      <section class='about-principles about-section' aria-labelledby='about-principles-title'>
        <div class='container'>
          <div class='about-copy about-principles__head' data-about-reveal>
            <span class='about-kicker'>{{aboutPage.principles.eyebrow}}</span>
            <h2 id='about-principles-title'>{{aboutPage.principles.title}}</h2>
            <p>{{aboutPage.principles.copy}}</p>
          </div>
          <div class='about-principles__grid'>
            {{#each aboutPage.principles.items}}
              <article class='about-principle' data-about-reveal>
                <span class='about-principle__number' aria-hidden='true'></span>
                <span class='about-principle__icon'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#{{icon}}'></use></svg></span>
                <div><h3>{{title}}</h3><p>{{copy}}</p></div>
              </article>
            {{/each}}
          </div>
        </div>
      </section>

      <section class='about-certification about-section' aria-labelledby='about-certification-title'>
        <div class='container about-certification__layout'>
          <div class='about-certification__head' data-about-reveal>
            <div class='about-copy'>
              <span class='about-kicker'>{{aboutPage.certification.eyebrow}}</span>
              <h2 id='about-certification-title'>{{aboutPage.certification.title}}</h2>
              <p>{{aboutPage.certification.copy}}</p>
            </div>
          </div>
          <div class='about-certification__gallery'>
            {{#each aboutPage.certification.items}}
              <button class='about-certification__gallery-item about-certification__gallery-item--{{layout}}' type='button' data-about-reveal data-about-certification-item data-src='{{image}}' data-alt='{{alt}}' data-caption='{{caption}}' aria-label='{{../aboutPage.certification.openImage}}: {{caption}}'>
                <img src='{{image}}' alt='{{alt}}' loading='lazy' decoding='async' />
                <span>{{caption}}</span>
              </button>
            {{/each}}
          </div>
        </div>
      </section>

      <section class='about-partners about-section' aria-labelledby='about-partners-title'>
        <div class='container about-partners__head' data-about-reveal>
          <div class='about-copy'>
            <span class='about-kicker'>{{aboutPage.partners.eyebrow}}</span>
            <h2 id='about-partners-title'>{{aboutPage.partners.title}}</h2>
            <p>{{aboutPage.partners.copy}}</p>
          </div>
        </div>
        <div class='container'>
          <div class='about-partners__track'>
            {{#each aboutPage.partners.items}}
              <article class='about-partner-card' data-about-reveal>
                <div class='about-partner-card__logo about-partner-card__logo--{{tone}}'><img src='{{logo}}' alt='{{name}}' loading='lazy' decoding='async' /></div>
                <div><strong>{{name}}</strong><span>{{detail}}</span>{{#if subdetail}}<small>{{subdetail}}</small>{{/if}}</div>
              </article>
            {{/each}}
          </div>
        </div>
      </section>

      <section class='about-company about-section' aria-labelledby='about-company-title'>
        <div class='container about-company__layout'>
          <div class='about-copy about-company__copy' data-about-reveal>
            <span class='about-kicker'>{{aboutPage.company.eyebrow}}</span>
            <h2 id='about-company-title'>{{aboutPage.company.title}}</h2>
            <p>{{aboutPage.company.copy}}</p>
          </div>
          <article class='about-company-record' data-about-reveal>
            <div class='about-company-record__top'>
              <span class='about-company-record__seal'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#shield-check'></use></svg></span>
              <p>{{aboutPage.company.recordLabel}}</p>
            </div>
            <dl>{{#each aboutPage.company.facts}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl>
            <div class='about-company-record__address'><span>{{aboutPage.company.addressLabel}}</span><strong>{{aboutPage.company.address}}</strong></div>
            <footer><span>{{aboutPage.company.source}}</span><span>{{aboutPage.company.verification}}</span></footer>
          </article>
        </div>
      </section>

      <section class='about-cta about-section' aria-labelledby='about-cta-title'>
        <div class='container'>
          <div class='about-cta__content' data-about-reveal>
            <div class='about-cta__media' aria-hidden='true'>
              <picture>
                <source type='image/avif' srcset='/images/about-cta-background-1024.avif 1024w, /images/about-cta-background-1600.avif 1600w' sizes='100vw' />
                <source type='image/webp' srcset='/images/about-cta-background-1024.webp 1024w, /images/about-cta-background-1600.webp 1600w' sizes='100vw' />
                <img src='/images/about-cta-background-1600.jpg' width='1600' height='900' alt='' loading='lazy' decoding='async' />
              </picture>
            </div>
            <div class='about-cta__veil' aria-hidden='true'></div>
            <div>
              <span class='about-cta__eyebrow'>{{aboutPage.finalCta.eyebrow}}</span>
              <h2 id='about-cta-title'>{{aboutPage.finalCta.title}}</h2>
            </div>
            <div class='about-cta__conversion'>
              <p>{{aboutPage.finalCta.copy}}</p>
              <div class='about-cta__actions'>
                <a class='button button--navy' href='{{calculatorHref}}'>{{aboutPage.finalCta.primary}} <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a>
                <a class='about-cta__outline' href='{{contactsHref}}'>{{aboutPage.finalCta.secondary}} <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <dialog class='about-lightbox' data-about-lightbox aria-label='{{aboutPage.certification.galleryTitle}}'>
      <button class='about-lightbox__close' type='button' data-about-lightbox-close aria-label='{{aboutPage.certification.closeImage}}'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#close'></use></svg></button>
      <button class='about-lightbox__direction about-lightbox__direction--previous' type='button' data-about-lightbox-previous aria-label='{{aboutPage.certification.previousImage}}'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-left'></use></svg></button>
      <img src='' alt='' data-about-lightbox-image />
      <p data-about-lightbox-caption></p>
      <button class='about-lightbox__direction about-lightbox__direction--next' type='button' data-about-lightbox-next aria-label='{{aboutPage.certification.nextImage}}'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></button>
    </dialog>

    {{> site-footer}}
    <script type='module' src='/src/main.js'></script>
  </body>
</html>
