<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#071a2d' />
    <meta name='color-scheme' content='light' />
    <title>{{meta.title}}</title>
    <meta name='description' content='{{meta.description}}' />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:locale' content='{{localeCode}}' />
    <meta property='og:title' content='{{meta.ogTitle}}' />
    <meta property='og:description' content='{{meta.ogDescription}}' />
    <meta property='og:url' content='https://yourenergy.am{{path}}' />
    <meta property='og:image' content='https://yourenergy.am/og.png' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content='{{meta.ogTitle}}' />
    <meta name='twitter:description' content='{{meta.ogDescription}}' />
    <meta name='twitter:image' content='https://yourenergy.am/og.png' />
    <link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.svg' type='image/svg+xml' />
    <link rel='stylesheet' href='/src/styles/main.css' />
    <script type='application/ld+json'>{{{jsonLd}}}</script>
  </head>
  <body{{#if isCalculatorPage}} class='calculator-page'{{/if}}>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>
    <header class='site-header' data-header>
      <div class='container header-row'>
        <a class='wordmark' href='{{homeHref}}' aria-label='{{aria.logo}}'><span>YOUR</span><strong
          >ENERGY</strong></a>
        {{#unless isCalculatorPage}}
          <nav class='desktop-nav' aria-label='{{aria.primaryNav}}'>
            <a href='{{calculatorHref}}'>{{nav.home}}</a>
            <a href='{{supportBase}}/soon/#business'>{{nav.business}}</a>
            <a href='#projects'>{{nav.projects}}</a>
            <a href='#process'>{{nav.process}}</a>
            <a href='#engineering'>{{nav.about}}</a>
            <a href='{{supportBase}}/soon/#blog'>{{nav.blog}}</a>
            <a href='#contacts'>{{nav.contacts}}</a>
          </nav>
        {{/unless}}
        <div class='header-actions'>
          <a class='header-phone' href='{{contact.phoneHref}}'><strong>{{contact.phone}}</strong><small
            >{{contact.hours}}</small></a>
          <nav class='language-switcher' aria-label='{{aria.languageNav}}'>{{#each
              languageLinks
            }}<a
                class='language-link'
                href='{{href}}'
                hreflang='{{hreflang}}'
                aria-label='{{label}} — {{name}}'
              >{{label}}</a>{{/each}}</nav>
          {{#unless isCalculatorPage}}
            <a class='button button--small' href='{{calculatorHref}}'>{{common.cta}}</a>
          {{/unless}}
        </div>
        <details class='mobile-menu' data-mobile-menu>
          <summary aria-label='{{aria.menu}}'><span></span><span></span><span></span></summary>
          <nav aria-label='{{#if isCalculatorPage}}{{toolShared.mobileNav}}{{else}}{{aria.mobileNav}}{{/if}}'>
            {{#if isCalculatorPage}}
              <a href='{{homeHref}}'>{{toolShared.home}}</a>
              <a href='{{contact.phoneHref}}'>{{toolShared.phone}}</a>
            {{else}}
              <a href='{{calculatorHref}}'>{{nav.home}}</a>
              <a href='{{supportBase}}/soon/#business'>{{nav.business}}</a>
              <a href='#projects'>{{nav.projects}}</a>
              <a href='#process'>{{nav.process}}</a>
              <a href='#engineering'>{{nav.about}}</a>
              <a href='{{supportBase}}/soon/#blog'>{{nav.blog}}</a>
              <a href='#contacts'>{{nav.contacts}}</a>
            {{/if}}
            <div class='mobile-language-switcher' role='group' aria-label='{{aria.languageNav}}'>{{#each
                languageLinks
              }}<a
                  class='language-link'
                  href='{{href}}'
                  hreflang='{{hreflang}}'
                  aria-label='{{label}} — {{name}}'
                >{{label}}</a>{{/each}}</div>
          </nav>
        </details>
      </div>
    </header>

    <main id='main'>
      {{#if isCalculatorPage}}
      <section class='hero section' id='calculator' aria-labelledby='hero-title'>
        <div class='container hero-grid'>
          <div class='hero-copy'>
            <p class='eyebrow'>{{hero.eyebrow}}</p>
            <h1 id='hero-title'>{{hero.titleLead}}<br />{{hero.titleMiddle}}<br /><mark
              >{{hero.titleAccent}}</mark></h1>
            <p class='hero-intro'>{{hero.calculatorCopy}}</p>
            <noscript>
              <style>
                .calculator-flow-region,
                .address-form,
                [data-location-stage],
                [data-roof-stage],
                [data-optional-upload],
                [data-analysis-status],
                [data-file-status],
                [data-analysis-region],
                .hero-tool-links,
                .hero-benefits,
                .hero-disclosure,
                .calculator-workspace-menu,
                #passport {
                  display: none !important;
                }
              </style>
              <section class='calculator-noscript' id='manual-consultation' aria-labelledby='calculator-noscript-title'>
                <h2 id='calculator-noscript-title'>{{toolShared.phone}}</h2>
                <p>{{product.common.noJsCalculator}}</p>
                <a class='button button--navy' href='{{contact.phoneHref}}'>{{contact.phone}}</a>
                <address>{{contact.address}}</address>
              </section>
            </noscript>
            <nav class='calculator-workspace-menu' data-calculator-menu aria-label='{{product.workspace.menuLabel}}'>
              <p class='calculator-workspace-menu__title'>{{product.workspace.title}}</p>
              <p class='calculator-workspace-menu__copy'>{{product.workspace.copy}}</p>
              <ol>{{#each product.workspace.items}}<li><a
                    href='#{{anchor}}'
                    data-calculator-menu-item='{{key}}'
                    {{#if active}}aria-current='step'{{/if}}
                  ><span>{{number}}</span><strong>{{label}}</strong><small>{{copy}}</small></a></li>{{/each}}</ol>
            </nav>
            <section class='calculator-flow-region' aria-labelledby='calculator-flow-title'>
              <h2 id='calculator-flow-title'>{{product.flow.title}}</h2>
              <ol class='calculator-flow' data-calculator-flow>
                {{#each product.flow.steps}}<li data-calculator-flow-step='{{@index}}'><span
                    class='calculator-flow__number'
                  >{{number}}</span><span><strong>{{title}}</strong><small>{{copy}}</small></span></li>{{/each}}
              </ol>
            </section>
            <form class='address-form' id='calculator-start' data-address-form action='#manual-consultation' novalidate tabindex='-1'>
              <label for='address'>{{hero.addressLabel}}</label>
              <div class='address-control'>
                <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#pin'></use></svg>
                <input
                  id='address'
                  name='address'
                  autocomplete='street-address'
                  placeholder='{{hero.addressPlaceholder}}'
                  maxlength='160'
                  aria-describedby='address-help analysis-status'
                />
                <button class='button button--navy' type='submit'>{{hero.analyze}}</button>
              </div>
              <small id='address-help' class='field-help'>{{hero.addressHelp}}</small>
              <button class='text-button address-manual-point' type='button' data-location-manual-start>
                {{product.location.chooseOnMap}}
              </button>
            </form>
            <section class='product-stage' data-location-stage hidden aria-labelledby='location-stage-title' tabindex='-1'>
              <p class='eyebrow'>{{product.location.title}}</p>
              <h2 id='location-stage-title'>{{product.location.confirmPrompt}}</h2>
              <p data-location-message>{{product.location.copy}}</p>
              <p class='location-result'><span>{{product.location.resultLabel}}</span><strong
                  data-location-address
                ></strong><small data-location-coordinates></small></p>
              <fieldset class='coordinate-fallback' aria-describedby='location-coordinates-help'>
                <legend>{{product.location.coordinatesTitle}}</legend>
                <p id='location-coordinates-help'>{{product.location.coordinatesHelp}}</p>
                <div><label for='location-latitude'>{{product.location.latitudeLabel}}<input
                      id='location-latitude'
                      type='number'
                      min='35'
                      max='44'
                      step='0.00001'
                      inputmode='decimal'
                      autocomplete='off'
                      data-location-latitude
                    /></label><label for='location-longitude'>{{product.location.longitudeLabel}}<input
                      id='location-longitude'
                      type='number'
                      min='40'
                      max='50'
                      step='0.00001'
                      inputmode='decimal'
                      autocomplete='off'
                      data-location-longitude
                    /></label></div>
                <button class='button button--outline' type='button' data-location-coordinates-submit>{{product.location.useCoordinates}}</button>
              </fieldset>
              <div class='flow-actions'><button
                  class='button button--navy'
                  type='button'
                  data-location-confirm
                >{{product.location.confirm}}</button><button
                  class='button button--outline'
                  type='button'
                  data-location-manual
                >{{product.location.chooseOnMap}}</button><button
                  class='button button--outline'
                  type='button'
                  data-location-center
                >{{product.location.useMapCenter}}</button></div>
            </section>
            <section class='product-stage roof-editor' id='roof-analysis' data-roof-stage hidden aria-labelledby='roof-stage-title' tabindex='-1'>
              <p class='eyebrow'>{{product.roof.title}}</p>
              <h2 id='roof-stage-title'>{{product.roof.copy}}</h2>
              <p data-roof-message>{{product.roof.locationRequired}}</p>
              <div class='flow-actions'><button
                  class='button button--navy'
                  type='button'
                  data-roof-start
                >{{product.roof.start}}</button><button
                  class='button button--outline'
                  type='button'
                  data-roof-add-center
                >{{product.roof.addPointAtCenter}}</button><button
                  class='button button--outline'
                  type='button'
                  data-roof-undo
                >{{product.roof.undo}}</button><button
                  class='button button--outline'
                  type='button'
                  data-roof-reset
                >{{product.roof.reset}}</button></div>
              <div class='roof-editor-controls'><label for='roof-mounting-mode'>{{product.roof.mountingModeLabel}}<select
                    id='roof-mounting-mode'
                    data-roof-mounting-mode
                    aria-describedby='roof-mounting-mode-help'
                  ><option value='roof-parallel'>{{product.roof.mountingModes.roofParallel}}</option><option value='elevated'>{{product.roof.mountingModes.elevated}}</option></select><small id='roof-mounting-mode-help'>{{product.roof.mountingModeHelp}}</small></label><label for='roof-orientation'>{{product.roof.orientationLabel}}<select
                    id='roof-orientation'
                    data-roof-orientation
                    required
                    aria-required='true'
                    aria-describedby='roof-orientation-help'
                    aria-errormessage='analysis-status'
                  ><option value='' selected>{{product.roof.orientationOptions.unknown}}</option><option value='180'>{{product.roof.orientationOptions.south}}</option><option
                      value='225'
                    >{{product.roof.orientationOptions.southWest}}</option><option value='135'
                    >{{product.roof.orientationOptions.southEast}}</option><option value='90'
                    >{{product.roof.orientationOptions.east}}</option><option value='270'
                    >{{product.roof.orientationOptions.west}}</option><option value='0'
                    >{{product.roof.orientationOptions.north}}</option><option value='custom'>{{product.roof.orientationOptions.custom}}</option></select><small id='roof-orientation-help'>{{product.roof.orientationHelp}}</small></label><label
                  data-roof-orientation-custom
                  hidden
                  for='roof-orientation-custom'
                >{{product.roof.customOrientationLabel}}<input
                    id='roof-orientation-custom'
                    type='number'
                    min='0'
                    max='359.999'
                    step='1'
                    inputmode='decimal'
                    aria-describedby='roof-orientation-custom-help'
                    aria-errormessage='analysis-status'
                    data-roof-orientation-custom-input
                  /><small id='roof-orientation-custom-help'>{{product.roof.customOrientationHelp}}</small></label><label
                  for='roof-tilt'
                >{{product.roof.tiltLabel}}<input
                    id='roof-tilt'
                    type='number'
                    min='0'
                    max='90'
                    step='1'
                    aria-describedby='roof-tilt-help'
                    aria-errormessage='analysis-status'
                    required
                    aria-required='true'
                    data-roof-tilt
                  /><small id='roof-tilt-help'>{{product.roof.tiltHelp}}</small></label></div>
              <fieldset class='roof-area-method' aria-describedby='roof-area-method-help'>
                <legend>{{product.roof.areaMethodTitle}}</legend>
                <p id='roof-area-method-help'>{{product.roof.areaMethodHelp}}</p>
                <label><input type='radio' name='roof-area-method' value='map-projected' checked data-roof-area-method /><span>{{product.roof.areaMethods.mapProjected}}</span></label>
                <label><input type='radio' name='roof-area-method' value='measured-plane' data-roof-area-method /><span>{{product.roof.areaMethods.measuredPlane}}</span></label>
                <label data-roof-plane-area-wrap hidden for='roof-plane-area'>{{product.roof.planeAreaLabel}}<div class='input-with-unit'><input
                      id='roof-plane-area'
                      type='number'
                      min='1'
                      max='100000'
                      step='0.1'
                      inputmode='decimal'
                      aria-describedby='roof-plane-area-help'
                      aria-errormessage='analysis-status'
                      data-roof-plane-area
                    /><span>m²</span></div><small id='roof-plane-area-help'>{{product.roof.planeAreaHelp}}</small></label>
              </fieldset>
              <figure class='roof-angle-preview' aria-labelledby='roof-angle-preview-title'>
                <figcaption id='roof-angle-preview-title'>{{product.roof.angleGuideTitle}}</figcaption>
                <div class='roof-angle-preview__grid'>
                  <svg class='roof-angle-preview__compass' viewBox='0 0 200 200' aria-hidden='true' focusable='false'>
                    <circle cx='100' cy='100' r='73'></circle><path d='M100 21V179M21 100H179'></path><text x='100' y='15'>N</text><text x='187' y='105'>E</text><text x='100' y='196'>S</text><text x='7' y='105'>W</text><g data-roof-preview-arrow transform='rotate(180 100 100)'><path d='M100 34 88 84h24z'></path><path d='M100 166 88 116h24z'></path></g>
                  </svg>
                  <dl><div><dt>{{product.roof.benchmarkOrientation}}</dt><dd data-roof-benchmark-orientation>—</dd></div><div><dt>{{product.roof.benchmarkTilt}}</dt><dd data-roof-benchmark-tilt>—</dd></div><div><dt>{{product.roof.angleGuideOrientation}}</dt><dd data-roof-preview-orientation>—</dd></div><div><dt>{{product.roof.angleGuideTilt}}</dt><dd data-roof-preview-tilt>—</dd></div></dl>
                </div>
                <p>{{product.roof.angleGuideCopy}}</p>
              </figure>
              <fieldset
                class='consumption-inputs'
                data-consumption-inputs
                aria-describedby='consumption-intro'
              >
                <legend>{{product.consumption.title}}</legend>
                <p id='consumption-intro'>{{product.consumption.copy}}</p>
                <div class='consumption-modes'>
                  <label><input type='radio' name='consumption-mode' value='bill' checked /><span
                    >{{product.consumption.modes.bill}}</span></label>
                  <label><input type='radio' name='consumption-mode' value='usage' /><span
                    >{{product.consumption.modes.usage}}</span></label>
                  <label><input type='radio' name='consumption-mode' value='monthly' /><span
                    >{{product.consumption.modes.monthly}}</span></label>
                </div>
                <div class='consumption-panel' data-consumption-panel='bill'>
                  <label for='consumption-bill'>{{product.consumption.billLabel}}</label>
                  <div class='input-with-unit'><input
                      id='consumption-bill'
                      type='number'
                      min='1'
                      step='1'
                      inputmode='decimal'
                      aria-describedby='consumption-bill-unit consumption-bill-help'
                      aria-errormessage='analysis-status'
                      data-consumption-bill
                    /><span id='consumption-bill-unit'>{{product.common.amd}} {{product.common.perMonth}}</span></div>
                  <small id='consumption-bill-help'>{{product.consumption.billHelp}}</small>
                </div>
                <div class='consumption-panel' data-consumption-panel='usage' hidden>
                  <label for='consumption-usage'>{{product.consumption.usageLabel}}</label>
                  <div class='input-with-unit'><input
                      id='consumption-usage'
                      type='number'
                      min='1'
                      step='1'
                      inputmode='decimal'
                      aria-describedby='consumption-usage-unit consumption-usage-help'
                      aria-errormessage='analysis-status'
                      data-consumption-usage
                    /><span id='consumption-usage-unit'>{{product.common.kwh}} {{product.common.perMonth}}</span></div>
                  <small id='consumption-usage-help'>{{product.consumption.usageHelp}}</small>
                </div>
                <div class='consumption-panel consumption-panel--months' data-consumption-panel='monthly' hidden>
                  <p id='consumption-monthly-title'>{{product.consumption.monthlyTitle}}</p>
                  <div
                    class='monthly-consumption-grid'
                    role='group'
                    aria-labelledby='consumption-monthly-title'
                    aria-describedby='consumption-monthly-unit consumption-monthly-help'
                  >{{#each passport.months}}<label
                      ><span>{{short}}</span><input
                        type='number'
                        min='0'
                        step='1'
                        inputmode='decimal'
                        aria-label='{{name}} — {{../product.common.kwh}}'
                        aria-describedby='consumption-monthly-unit consumption-monthly-help'
                        aria-errormessage='analysis-status'
                        data-consumption-month
                      /></label>{{/each}}</div>
                  <span class='visually-hidden' id='consumption-monthly-unit'>{{product.common.kwh}}</span>
                  <small id='consumption-monthly-help'>{{product.consumption.monthlyHelp}}</small>
                </div>
                <div class='manual-tariff'>
                  <label for='consumption-tariff'>{{product.consumption.tariffLabel}}</label>
                  <div class='input-with-unit'><input
                      id='consumption-tariff'
                      type='number'
                      min='0.01'
                      max='1000'
                      step='0.01'
                      inputmode='decimal'
                      aria-describedby='consumption-tariff-unit consumption-tariff-help'
                      aria-errormessage='analysis-status'
                      data-consumption-tariff
                    /><span id='consumption-tariff-unit'>{{product.common.amd}} / {{product.common.kwh}}</span></div>
                  <small id='consumption-tariff-help'>{{product.consumption.tariffHelp}}</small>
                </div>
                <p class='consumption-total'><span>{{product.consumption.annualLabel}}</span><output
                    data-consumption-annual
                    aria-label='{{product.consumption.annualLabel}} — {{product.common.kwh}}'
                    aria-live='polite'
                  >—</output> {{product.common.kwh}}</p>
              </fieldset>
              <p class='roof-editor__summary'><span data-roof-points>{{product.roof.pointsLabel}}</span><strong
                  data-roof-area
                >—</strong></p><p class='roof-editor__summary roof-editor__summary--plane'><span>{{product.roof.planeAreaSummary}}</span><strong
                  data-roof-effective-area
                >—</strong></p>
              <div class='roof-nudge-controls' data-roof-nudge-controls hidden><label
                  for='roof-point-select'
                >{{product.roof.pointSelectLabel}}<select id='roof-point-select' data-roof-point-select></select></label><div
                  ><button type='button' data-roof-nudge='north' aria-label='{{product.roof.nudgeNorth}}'>↑</button><button
                    type='button'
                    data-roof-nudge='west'
                    aria-label='{{product.roof.nudgeWest}}'
                  >←</button><button type='button' data-roof-nudge='east' aria-label='{{product.roof.nudgeEast}}'>→</button><button
                    type='button'
                    data-roof-nudge='south'
                    aria-label='{{product.roof.nudgeSouth}}'
                  >↓</button><button type='button' data-roof-remove>{{product.roof.removePoint}}</button></div></div>
              <button
                class='button'
                type='button'
                data-roof-finish
                aria-describedby='roof-calculate-help'
                disabled
              >{{product.roof.finish}}</button>
              <p class='roof-editor__calculate-help' id='roof-calculate-help'>{{product.roof.finishHelp}}</p>
            </section>
            <div class='upload-block' data-file-drop data-optional-upload hidden>
              <label class='upload-control' for='bill-file'>
                <span class='upload-icon' aria-hidden='true'><svg class='inline-icon'><use
                      href='/icons.svg#file'
                    ></use></svg></span>
                <span><strong>{{hero.uploadTitle}}</strong><small>{{hero.uploadPrompt}}
                    ·
                    {{hero.uploadHelp}}</small></span>
                <input
                  id='bill-file'
                  class='upload-control__input'
                  type='file'
                  accept='.pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png'
                  aria-describedby='file-status'
                />
              </label>
              <div class='file-selection' data-file-meta hidden>
                <span data-file-name></span>
                <button
                  class='text-button'
                  type='button'
                  data-file-remove
                >{{hero.removeFile}}</button>
              </div>
            </div>
            <p class='form-status' id='analysis-status' data-analysis-status aria-live='polite'></p>
            <p class='form-status' id='file-status' data-file-status aria-live='polite'></p>
            <ul class='hero-benefits' role='list'>
              {{#each hero.benefits}}<li><svg class='inline-icon' aria-hidden='true'><use
                      href='/icons.svg#check'
                    ></use></svg>{{this}}</li>{{/each}}
            </ul>
            <p class='hero-disclosure'>{{hero.disclosure}}</p>
          </div>

          <div class='roof-product' data-analysis-region aria-label='{{map.title}}'>
            <figure class='roof-visual' data-map-shell>
              <picture>
                <source
                  type='image/avif'
                  srcset='/images/roof-scan-480.avif 480w, /images/roof-scan-768.avif 768w, /images/roof-scan-1200.avif 1200w, /images/roof-scan-1600.avif 1600w'
                  sizes='(max-width: 760px) 100vw, 50vw'
                />
                <source
                  type='image/webp'
                  srcset='/images/roof-scan-480.webp 480w, /images/roof-scan-768.webp 768w, /images/roof-scan-1200.webp 1200w, /images/roof-scan-1600.webp 1600w'
                  sizes='(max-width: 760px) 100vw, 50vw'
                />
                <img
                  src='/images/roof-scan-1200.jpg'
                  srcset='/images/roof-scan-480.jpg 480w, /images/roof-scan-768.jpg 768w, /images/roof-scan-1200.jpg 1200w, /images/roof-scan-1600.jpg 1600w'
                  sizes='(max-width: 760px) 100vw, 50vw'
                  width='1600'
                  height='1067'
                  alt='{{map.imageAlt}}'
                  fetchpriority='high'
                  decoding='async'
                />
              </picture>
              <div class='roof-shade' aria-hidden='true'></div>
              <svg class='roof-overlay' viewBox='0 0 1000 660' aria-hidden='true' focusable='false'>
                <polygon points='295,125 670,214 616,499 239,410' class='roof-boundary'></polygon>
                <g class='panel-grid'>
                  <rect x='330' y='195' width='66' height='49'></rect><rect
                    x='400'
                    y='212'
                    width='66'
                    height='49'
                  ></rect><rect x='470' y='229' width='66' height='49'></rect><rect
                    x='540'
                    y='246'
                    width='66'
                    height='49'
                  ></rect>
                  <rect x='314' y='261' width='66' height='49'></rect><rect
                    x='384'
                    y='278'
                    width='66'
                    height='49'
                  ></rect><rect x='454' y='295' width='66' height='49'></rect><rect
                    x='524'
                    y='312'
                    width='66'
                    height='49'
                  ></rect>
                  <rect x='298' y='327' width='66' height='49'></rect><rect
                    x='368'
                    y='344'
                    width='66'
                    height='49'
                  ></rect><rect x='438' y='361' width='66' height='49'></rect><rect
                    x='508'
                    y='378'
                    width='66'
                    height='49'
                  ></rect>
                  <rect x='282' y='393' width='66' height='49'></rect><rect
                    x='352'
                    y='410'
                    width='66'
                    height='49'
                  ></rect><rect x='422' y='427' width='66' height='49'></rect><rect
                    x='492'
                    y='444'
                    width='66'
                    height='49'
                  ></rect>
                </g>
              </svg>
              <figcaption class='map-caption'><span class='demo-badge'>{{map.demo}}</span><span
                >{{map.disclosure}}</span></figcaption>
              <div
                class='property-map'
                data-property-map
                hidden
                aria-label='{{product.location.manualTitle}}'
              ></div>
