<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#071a2d' />
    <meta name='color-scheme' content='light' />
    <title>{{meta.title}}</title>
    <meta name='description' content='{{meta.description}}' />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:locale' content='{{localeCode}}' />
    <meta property='og:title' content='{{meta.ogTitle}}' />
    <meta property='og:description' content='{{meta.ogDescription}}' />
    <meta property='og:url' content='https://yourenergy.am{{path}}' />
    <meta property='og:image' content='https://yourenergy.am/og.png' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content='{{meta.ogTitle}}' />
    <meta name='twitter:description' content='{{meta.ogDescription}}' />
    <meta name='twitter:image' content='https://yourenergy.am/og.png' />
    <link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' href='/yourenergy-mark.svg' type='image/svg+xml' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />
    <link rel='stylesheet' href='/src/styles/home.css' />
    <script type='application/ld+json'>{{{jsonLd}}}</script>
  </head>
  <body class='page-home'>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>
    {{> site-header}}

    <main id='main' data-home-story>
      <section class='hero section home-hero' id='top' aria-labelledby='hero-title' data-home-hero>
        <div class='hero-backdrop' aria-hidden='true' data-hero-time-backdrop>
          <picture class='hero-backdrop__picture'>
            <source
              type='image/avif'
              srcset='/images/hero-time-8-640.avif 640w, /images/hero-time-8-1024.avif 1024w, /images/hero-time-8-1600.avif 1600w'
              sizes='100vw'
              data-hero-time-source='avif'
            />
            <source
              type='image/webp'
              srcset='/images/hero-time-8-640.webp 640w, /images/hero-time-8-1024.webp 1024w, /images/hero-time-8-1600.webp 1600w'
              sizes='100vw'
              data-hero-time-source='webp'
            />
            <img
              src='/images/hero-time-8-1600.jpg'
              srcset='/images/hero-time-8-640.jpg 640w, /images/hero-time-8-1024.jpg 1024w, /images/hero-time-8-1600.jpg 1600w'
              sizes='100vw'
              width='1600'
              height='900'
              alt=''
              fetchpriority='high'
              decoding='async'
              data-hero-time-image
            />
          </picture>
          <img class='hero-backdrop__transition' alt='' decoding='async' data-hero-time-transition />
          <img class='hero-backdrop__transition' alt='' decoding='async' data-hero-time-transition />
          <img class='hero-backdrop__transition' alt='' decoding='async' data-hero-time-transition />
          <img class='hero-backdrop__transition' alt='' decoding='async' data-hero-time-transition />
          <img class='hero-backdrop__transition' alt='' decoding='async' data-hero-time-transition />
        </div>
        <div class='hero-scrim' aria-hidden='true'></div>
        <span class='hero-time-sun' data-hero-time-sun aria-hidden='true'></span>
        <div class='hero-frame'>
          <div class='container hero-grid'>
            <div class='hero-copy' data-hero-copy>
            <p class='eyebrow'>{{hero.eyebrow}}</p>
            <h1 id='hero-title'>{{hero.titleLead}}<br />{{hero.titleMiddle}}<br /><mark
              >{{hero.titleAccent}}</mark></h1>
            <p class='hero-intro'>{{hero.homeCopy}}</p>
            <div class='hero-actions'>
              <a class='button button--navy' href='{{calculatorHref}}'>{{hero.openCalculator}}</a>
            </div>
            </div>

            <aside
              class='hero-dashboard'
              data-hero-dashboard
              data-dashboard-mode='example'
              aria-label='{{hero.dashboardAriaLabel}}'
            >
              <div class='hero-dashboard__top'>
                <span class='hero-dashboard__location'><svg class='inline-icon' aria-hidden='true'><use
                      href='/icons.svg#map-pin'
                    ></use></svg><span data-hero-analysis-location>{{hero.dashboardExample.location}}</span></span>
                <span class='hero-dashboard__status' data-hero-analysis-status>{{hero.dashboardExample.status}}</span>
              </div>
              <p class='hero-dashboard__label' data-hero-analysis-label aria-live='polite'>{{hero.dashboardExample.label}}</p>
              <div class='hero-dashboard__production'>
                <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#sun'></use></svg>
                <span>{{hero.dashboardGeneration}}</span>
              </div>
              <div class='hero-dashboard__yield'>
                <div class='hero-dashboard__metric'><strong data-hero-analysis-generation data-hero-countup data-hero-countup-value='{{hero.dashboardExample.annualGenerationKwh}}'>{{hero.dashboardExample.annualGenerationDisplay}}</strong><span data-hero-analysis-generation-unit>{{hero.dashboardGenerationUnit}}</span></div>
                <div class='hero-dashboard__bars' data-hero-analysis-bars role='img' aria-label='{{hero.dashboardGeneration}}'>{{#each hero.dashboardExample.monthlyBarPercent}}<i style='--hero-bar-height: {{this}}%;'></i>{{/each}}</div>
              </div>
              <dl class='hero-dashboard__facts'>
                <div data-hero-example-co2><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#leaf'></use></svg><dt>{{hero.dashboardExample.co2Label}}</dt><dd><strong data-hero-example-co2-value data-hero-countup data-hero-countup-value='{{hero.dashboardExample.co2Tons}}' data-hero-countup-decimals='1'>{{hero.dashboardExample.co2Display}}</strong> <small>{{hero.dashboardCo2Unit}}</small></dd></div>
                <div data-hero-analysis-coverage hidden><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#shield-check'></use></svg><dt>{{hero.dashboardCoverage}}</dt><dd><strong data-hero-analysis-coverage-value>{{hero.dashboardNeedConsumption}}</strong> <small data-hero-analysis-coverage-unit hidden>{{hero.dashboardCoverageUnit}}</small></dd></div>
                <div data-hero-analysis-savings hidden><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#zap'></use></svg><dt>{{hero.dashboardSavings}}</dt><dd><strong data-hero-analysis-savings-value>{{hero.dashboardNeedTariff}}</strong> <small data-hero-analysis-savings-unit hidden>{{hero.dashboardSavingsUnit}}</small></dd></div>
                <div data-hero-analysis-co2 hidden><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#leaf'></use></svg><dt>{{hero.dashboardCo2}}</dt><dd><strong data-hero-analysis-co2-value>—</strong> <small data-hero-analysis-co2-unit>{{hero.dashboardCo2Unit}}</small></dd></div>
                <div data-hero-example-trees><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#tree'></use></svg><dt>{{hero.dashboardExample.treesLabel}}</dt><dd><strong data-hero-example-trees-value data-hero-countup data-hero-countup-value='{{hero.dashboardExample.trees}}'>{{hero.dashboardExample.trees}}</strong> <small>{{hero.dashboardExample.treesUnit}}</small></dd></div>
              </dl>
              <p class='hero-dashboard__note'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#zap'></use></svg><span data-hero-analysis-note>{{hero.dashboardExample.note}}</span></p>
            </aside>
          </div>
          <p class='hero-signature'>{{hero.signatureLead}}<br />{{hero.signatureTail}}<svg
              viewBox='0 0 160 24'
              aria-hidden='true'
              focusable='false'
            ><path d='M58 10c15-4 31-5 47-2'></path><path
                d='M82 16c18-3 36-3 53-1 4 0 7 1 10 1'
              ></path></svg></p>
          <aside class='trust-strip hero-trust-strip' aria-label='{{trust.disclosure}}'>
            <div class='container trust-strip__inner'>
              {{#each trust.items}}
                <div class='trust-item'><svg class='inline-icon' aria-hidden='true'><use
                      href='/icons.svg#{{icon}}'
                    ></use></svg><p><strong>{{title}}</strong><span>{{note}}</span></p></div>
              {{/each}}
            </div>
          </aside>
        </div>
      </section>

      <section class='portfolio-projects' id='projects' aria-labelledby='projects-title'>
        <div class='portfolio-projects__backdrop' aria-hidden='true'><picture><source
              type='image/avif'
              srcset='/images/hero-time-18-1024.avif 1024w, /images/hero-time-18-1600.avif 1600w'
              sizes='100vw'
            /><source
              type='image/webp'
              srcset='/images/hero-time-18-1024.webp 1024w, /images/hero-time-18-1600.webp 1600w'
              sizes='100vw'
            /><img
              src='/images/hero-time-18-1600.jpg'
              width='1600'
              height='900'
              alt=''
              loading='lazy'
              decoding='async'
            /></picture></div>
        <div class='portfolio-projects__header container'>
          <div class='portfolio-projects__copy'><p class='portfolio-projects__eyebrow'>{{projects.eyebrow}}</p><h2
              id='projects-title'
            ><span>{{projects.titleLead}}</span><mark>{{projects.titleAccent}}</mark></h2><p
              class='portfolio-projects__description'
            >{{projects.copy}}</p></div>
          <div class='portfolio-projects__actions'><a
              class='portfolio-projects__button portfolio-projects__button--primary'
              href='{{projects.allHref}}'
            ><svg class='portfolio-projects__button-icon' aria-hidden='true' viewBox='0 0 24 24'><rect
                  x='4'
                  y='4'
                  width='6'
                  height='6'
                  rx='1'
                ></rect><rect x='14' y='4' width='6' height='6' rx='1'></rect><rect
                  x='4'
                  y='14'
                  width='6'
                  height='6'
                  rx='1'
                ></rect><rect x='14' y='14' width='6' height='6' rx='1'></rect></svg><span
              >{{projects.viewAll}}</span><svg class='inline-icon' aria-hidden='true'><use
                  href='/icons.svg#arrow-right'
                ></use></svg></a><a
              class='portfolio-projects__button portfolio-projects__button--secondary'
              href='{{projects.discussHref}}'
            ><svg class='inline-icon' aria-hidden='true'><use
                  href='/icons.svg#message-square'
                ></use></svg><span>{{projects.discuss}}</span><svg class='inline-icon' aria-hidden='true'><use
                  href='/icons.svg#arrow-right'
                ></use></svg></a></div>
        </div>
        <div class='portfolio-projects__rail'>
          <div class='portfolio-projects__track' data-projects-track tabindex='0'>
            {{#each projects.items}}
              <article class='portfolio-project-card'>
                <div class='portfolio-project-card__media'><picture><source
                      type='image/avif'
                      srcset='{{avifSrcset}}'
                      sizes='{{imageSizes}}'
                    /><source
                      type='image/webp'
                      srcset='{{webpSrcset}}'
                      sizes='{{imageSizes}}'
                    /><img
                      src='/images/{{image}}-800.jpg'
                      width='800'
                      height='533'
                      alt='{{illustrativeLabel}}: {{type}}, {{city}}'
                      loading='lazy'
                      decoding='async'
                    /></picture><span class='portfolio-project-card__location'><svg
                      class='inline-icon'
                      aria-hidden='true'
                    ><use href='/icons.svg#map-pin'></use></svg>{{city}}</span><h3>{{type}}</h3></div>
                <div class='portfolio-project-card__body'><ul
                    class='portfolio-project-card__metrics'
                    role='list'
                  >{{#each metrics}}<li><svg class='inline-icon' aria-hidden='true'><use
                          href='/icons.svg#{{icon}}'
                        ></use></svg><span><strong>{{value}}</strong><small>{{label}}</small></span></li>{{/each}}</ul><a
                    class='portfolio-project-card__link'
                    href='{{href}}'
                  ><span>{{action}}</span><svg class='inline-icon' aria-hidden='true'><use
                        href='/icons.svg#arrow-right'
                      ></use></svg></a></div>
              </article>
            {{/each}}
          </div>
          <div class='portfolio-projects__rail-footer'><div
              class='portfolio-projects__rail-meta'
            ><div class='portfolio-projects__progress' aria-hidden='true'>{{#each projects.items}}<i></i>{{/each}}</div><p><svg
                  class='inline-icon'
                  aria-hidden='true'
                ><use href='/icons.svg#leaf'></use></svg>{{projects.signature}}</p></div><div
              class='portfolio-projects__arrows'
            ><button
                class='portfolio-projects__arrow'
                type='button'
                data-project-direction='-1'
                aria-label='{{aria.previousProject}}'
              ><svg class='inline-icon' aria-hidden='true'><use
                    href='/icons.svg#arrow-left'
                  ></use></svg></button><button
                class='portfolio-projects__arrow portfolio-projects__arrow--next'
                type='button'
                data-project-direction='1'
                aria-label='{{aria.nextProject}}'
              ><svg class='inline-icon' aria-hidden='true'><use
                    href='/icons.svg#arrow-right'
                  ></use></svg></button></div></div>
        </div>
      </section>

      <section
        id='process'
        class='process process-journey section'
        data-process-story
        aria-labelledby='process-title'
      >
        {{> journey-story}}
      </section>

      <section class='faq-preview' id='faq' aria-labelledby='faq-title'>
        <div class='faq-preview__backdrop' aria-hidden='true'><picture><source
              type='image/avif'
              srcset='/images/hero-time-18-1024.avif 1024w, /images/hero-time-18-1600.avif 1600w'
              sizes='100vw'
            /><source
              type='image/webp'
              srcset='/images/hero-time-18-1024.webp 1024w, /images/hero-time-18-1600.webp 1600w'
              sizes='100vw'
            /><img
              src='/images/hero-time-18-1600.jpg'
              width='1600'
              height='900'
              alt=''
              loading='lazy'
              decoding='async'
            /></picture></div>
        <div class='container faq-preview__inner'>
          <header class='faq-preview__heading'><p class='eyebrow'>{{faq.eyebrow}}</p><h2 id='faq-title'>{{faq.homeTitle}}</h2><p>{{faq.intro}}</p></header>
          <div class='faq-preview__grid'>{{#each faq.previewItems}}<a class='faq-preview__card' href='{{../faqHref}}'><span class='faq-preview__icon'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#{{icon}}'></use></svg></span><span class='faq-preview__card-copy'><strong>{{question}}</strong><small>{{answer}}</small></span><svg class='faq-preview__arrow inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a>{{/each}}</div>
          <div class='faq-preview__footer'><a class='button faq-preview__button' href='{{faqHref}}'><span>{{faq.allQuestions}}</span><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a><p>{{faq.notFound}} <a href='{{contactsHref}}'>{{faq.contactLink}}</a></p></div>
        </div>
      </section>

    </main>

    {{> site-footer}}

    <script id='home-page-config' type='application/json'>{{{homePageConfig}}}</script>
    <script id='process-page-config' type='application/json'>{{{processPageConfig}}}</script>
    <script type='module' src='/src/main.js'></script>
  </body>
</html>
