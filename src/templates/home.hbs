        </div>
      </section>

      {{#unless isCalculatorPage}}
      <section class='engineering section' id='engineering' aria-labelledby='engineering-title'><div
          class='container engineering-grid'
        ><div class='engineering-photo'><picture><source
                type='image/avif'
                srcset='/images/engineer-onsite-480.avif 480w, /images/engineer-onsite-800.avif 800w, /images/engineer-onsite-1200.avif 1200w'
                sizes='(max-width: 760px) 100vw, 50vw'
              /><source
                type='image/webp'
                srcset='/images/engineer-onsite-480.webp 480w, /images/engineer-onsite-800.webp 800w, /images/engineer-onsite-1200.webp 1200w'
                sizes='(max-width: 760px) 100vw, 50vw'
              /><img
                src='/images/engineer-onsite-800.jpg'
                width='800'
                height='533'
                alt='{{engineering.imageAlt}}'
                loading='lazy'
                decoding='async'
              /></picture><span class='demo-badge'>{{common.illustrative}}</span><p
            >{{engineering.imageNote}}</p></div><div><p
              class='eyebrow'
            >{{engineering.eyebrow}}</p><h2 id='engineering-title'>{{engineering.title}}</h2><p
            >{{engineering.copy}}</p><ul class='check-list' role='list'>{{#each
                engineering.items
              }}<li><svg class='inline-icon' aria-hidden='true'><use
                      href='/icons.svg#check'
                    ></use></svg>{{this}}</li>{{/each}}</ul></div></div></section>

      <section class='equipment' aria-labelledby='equipment-title'><div class='container'><h2
            id='equipment-title'
          >{{equipment.title}}</h2><div class='brand-row' role='list'>{{#each
              equipment.brands
            }}<span role='listitem'>{{this}}</span>{{/each}}</div><p
          >{{equipment.note}}</p><div
            class='equipment-documents'
            id='equipment-documents'
            aria-labelledby='equipment-documents-title'
          ><div class='equipment-documents__heading'><h3
                id='equipment-documents-title'
              >{{equipment.documentsTitle}}</h3><p>{{equipment.documentsCopy}}</p></div><ul
              class='equipment-documents__grid'
              role='list'
            >{{#each equipment.documents}}<li class='equipment-document'><p
                  class='equipment-document__vendor'
                >{{vendor}}</p><h4>{{title}}</h4><dl>{{#each facts}}<div><dt>{{label}}</dt><dd
                      >{{value}}</dd></div>{{/each}}</dl><a
                  class='text-link equipment-document__link'
                  href='{{href}}'
                  type='application/pdf'
                  target='_blank'
                  rel='noopener'
                >{{../equipment.documentAction}} <svg class='inline-icon' aria-hidden='true'><use
                      href='/icons.svg#arrow-right'
                    ></use></svg></a><p class='equipment-document__note'>{{note}}</p></li>{{/each}}</ul><p
              class='equipment-documents__disclosure'
            >{{equipment.documentsDisclosure}}</p></div></div></section>

      <section
        class='myenergy section section--soft'
        id='myenergy'
        aria-labelledby='myenergy-title'
      ><div class='container myenergy-grid'><div><p class='eyebrow'>{{myEnergy.eyebrow}}</p><h2
              id='myenergy-title'
            >{{myEnergy.title}}</h2><p>{{myEnergy.copy}}</p><a
              class='button'
              href='{{supportBase}}/soon/#account'
            >{{myEnergy.cta}}</a><p class='section-disclosure'>{{myEnergy.note}}</p></div><div
            class='myenergy-dashboard'
            aria-label='MyEnergy {{common.demo}}'
          ><div class='dashboard-top'><span class='pulse'></span><span>YOURENERGY · MyEnergy</span><span
                class='pill'
              >{{common.soon}}</span></div><div class='dashboard-grid'>{{#each
                myEnergy.metrics
              }}<div><span>{{label}}</span><strong>{{value}}</strong></div>{{/each}}</div><div
              class='dashboard-wave'
              aria-hidden='true'
            ><span></span><span></span><span></span><span></span><span></span><span></span><span
              ></span></div></div></div></section>

      <section
        class='testimonials section'
        id='testimonials'
        aria-labelledby='testimonials-title'
      ><div class='container'><div class='section-heading section-heading--actions'><div><p
                class='eyebrow'
              >{{testimonials.eyebrow}}</p><h2
                id='testimonials-title'
              >{{testimonials.title}}</h2></div><p>{{testimonials.disclosure}}</p></div><div
            class='testimonials-toolbar'
          ><span class='demo-badge'>{{common.demo}}</span><div><button
                class='round-button'
                type='button'
                data-testimonial-direction='-1'
                aria-label='{{aria.previousTestimonial}}'
              >←</button><button
                class='round-button'
                type='button'
                data-testimonial-direction='1'
                aria-label='{{aria.nextTestimonial}}'
              >→</button></div></div><div
            class='testimonials-track'
            data-testimonials-track
            tabindex='0'
          >{{#each testimonials.items}}<blockquote class='testimonial'><svg
                  class='quote-mark'
                  aria-hidden='true'
                ><use href='/icons.svg#quote'></use></svg><p>«{{quote}}»</p><footer><strong
                  >{{name}}</strong><span
                  >{{city}}</span></footer></blockquote>{{/each}}</div></div></section>

      <section class='faq section section--soft' id='faq' aria-labelledby='faq-title'><div
          class='container faq-layout'
        ><div><p class='eyebrow'>{{faq.eyebrow}}</p><h2 id='faq-title'>{{faq.title}}</h2></div><div
            class='faq-list'
          >{{#each faq.items}}<details><summary>{{question}}<span
                    aria-hidden='true'
                  >+</span></summary><p>{{answer}}</p></details>{{/each}}</div></div></section>

      <section class='final-cta section' id='final-cta' aria-labelledby='final-title'><div
          class='container final-cta__inner'
        ><div><p class='eyebrow eyebrow--dark'>YOURENERGY</p><h2
              id='final-title'
            >{{finalCta.title}}</h2><p>{{finalCta.copy}}</p></div><div class='final-cta__actions'><a
              class='button'
              href='{{calculatorHref}}'
            >{{finalCta.primary}}</a><small>{{finalCta.note}}</small></div></div></section>
      {{/unless}}
    </main>

    {{#if isCalculatorPage}}
      <footer class='tool-footer'>
        <div class='container'>
          <p>{{toolShared.footer}}</p>
          <a href='{{contact.phoneHref}}'>{{contact.phone}}</a>
        </div>
      </footer>
    {{else}}
    <footer class='site-footer' id='contacts'><div class='container footer-grid'><div><a
            class='wordmark'
            href='{{homeHref}}'
          ><span>YOUR</span><strong>ENERGY</strong></a><p>{{footer.description}}</p><a
            class='footer-account'
            href='{{supportBase}}/soon/#account'
          >{{footer.account}}</a></div>{{#each footer.columns}}<div><h2>{{title}}</h2><ul
              role='list'
            >{{#each links}}<li><a
                    href='{{this.[1]}}'
                  >{{this.[0]}}</a></li>{{/each}}</ul></div>{{/each}}<div class='footer-contact'><h2
        >{{nav.contacts}}</h2><p><svg class='inline-icon' aria-hidden='true'><use
                href='/icons.svg#phone'
              ></use></svg><a href='{{contact.phoneHref}}'>{{contact.phone}}</a></p><p><svg
                class='inline-icon'
                aria-hidden='true'
            ><use href='/icons.svg#pin'></use></svg><address>{{contact.address}}</address></p><p><svg class='inline-icon' aria-hidden='true'><use
                href='/icons.svg#sun'
              ></use></svg><span>{{contact.hours}}</span></p><small
          >{{contact.note}}</small></div></div><div class='container footer-bottom'><span
        >{{footer.copyright}}</span><span><a
            href='{{supportBase}}/privacy/'
          >{{footer.privacy}}</a><a
            href='{{supportBase}}/terms/'
          >{{footer.terms}}</a></span></div></footer>
    {{/if}}

    <dialog class='passport-dialog' data-passport-dialog aria-labelledby='dialog-title'><form
        method='dialog'
        class='dialog-close'
      ><button class='round-button' aria-label='{{passport.close}}'><span
            aria-hidden='true'
          >×</span></button></form><div class='dialog-content'><p
          class='eyebrow'
        data-passport-dialog-eyebrow
        >{{passport.reportLabel}} · {{#if isCalculatorPage}}{{product.result.title}}{{else}}{{common.demo}}{{/if}}</p><h2
          id='dialog-title'
          data-passport-dialog-title
        >{{passport.dialogTitle}}</h2><div class='dialog-report'><article class='passport-card'><div
              class='passport-card__top'
            ><span class='wordmark wordmark--small'><span>YOUR</span><strong
                >ENERGY</strong></span><span class='pill' data-passport-badge>{{passport.badge}}</span></div><p
              class='passport-label'
            >{{passport.reportLabel}}</p><h3
              data-analysis-location
            >{{passport.reportAddress}}</h3><dl class='passport-specs'><div><dt
                >{{passport.system}}</dt><dd
                  data-analysis='capacity'
                >{{passport.capacity}}</dd></div><div><dt data-passport-source-label>{{passport.source}}</dt><dd
                  data-analysis='panels'
                >{{passport.panels}}</dd></div></dl></article><div class='dialog-numbers'><h3
            >{{passport.chartTitle}}</h3><dl>{{#each metrics}}<div><dt>{{label}}</dt><dd
                    data-analysis='{{key}}'
                  >{{value}} {{unit}}</dd></div>{{/each}}</dl><p
            >{{finance.disclaimer}}</p></div></div></div></dialog>

    {{#if isCalculatorPage}}
      <script id='page-config' type='application/json'>{{{pageConfig}}}</script>
      <script type='module' src='/src/main.js'></script>
    {{else}}
      <script type='module' src='/src/home.js'></script>
    {{/if}}
  </body>
</html>
