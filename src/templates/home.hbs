<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#071a2d' />
    <meta name='color-scheme' content='light' />
    <title>{{meta.title}}</title>
    <meta name='description' content='{{meta.description}}' />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:locale' content='{{localeCode}}' />
    <meta property='og:title' content='{{meta.ogTitle}}' />
    <meta property='og:description' content='{{meta.ogDescription}}' />
    <meta property='og:url' content='https://yourenergy.am{{path}}' />
    <meta property='og:image' content='https://yourenergy.am/og.png' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content='{{meta.ogTitle}}' />
    <meta name='twitter:description' content='{{meta.ogDescription}}' />
    <meta name='twitter:image' content='https://yourenergy.am/og.png' />
    <link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.svg' type='image/svg+xml' />
    <link rel='stylesheet' href='/src/styles/main.css' />
    <script type='application/ld+json'>{{{jsonLd}}}</script>
  </head>
  <body class='page-home'>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>
    {{> site-header}}

    <main id='main' data-home-story>
      <section class='hero section home-hero' id='top' aria-labelledby='hero-title' data-home-hero>
        <picture class='hero-backdrop' aria-hidden='true' data-hero-time-backdrop>
          <source
            type='image/avif'
            srcset='/images/hero-time-8-640.avif 640w, /images/hero-time-8-1024.avif 1024w, /images/hero-time-8-1600.avif 1600w'
            sizes='100vw'
            data-hero-time-source='avif'
          />
          <source
            type='image/webp'
            srcset='/images/hero-time-8-640.webp 640w, /images/hero-time-8-1024.webp 1024w, /images/hero-time-8-1600.webp 1600w'
            sizes='100vw'
            data-hero-time-source='webp'
          />
          <img
            src='/images/hero-time-8-1600.jpg'
            srcset='/images/hero-time-8-640.jpg 640w, /images/hero-time-8-1024.jpg 1024w, /images/hero-time-8-1600.jpg 1600w'
            sizes='100vw'
            width='1600'
            height='900'
            alt=''
            fetchpriority='high'
            decoding='async'
            data-hero-time-image
          />
        </picture>
        <div class='hero-scrim' aria-hidden='true'></div>
        <span class='hero-time-sun' data-hero-time-sun aria-hidden='true'></span>
        <p class='hero-sun-note' aria-hidden='true'><span>{{hero.sunNoteLead}}</span><span>{{hero.sunNoteTail}}</span></p>
        <p class='hero-outlook-note' aria-hidden='true'><span>{{hero.outlookLead}}</span><span>{{hero.outlookTail}}</span></p>
        <div class='hero-frame'>
          <div class='container hero-grid'>
            <div class='hero-copy' data-hero-copy>
            <p class='eyebrow'>{{hero.eyebrow}}</p>
            <h1 id='hero-title'>{{hero.titleLead}}<br />{{hero.titleMiddle}}<br /><mark
              >{{hero.titleAccent}}</mark></h1>
            <p class='hero-intro'>{{hero.homeCopy}}</p>
            <div class='hero-actions'>
              <a class='button button--navy' href='{{calculatorHref}}'>{{hero.openCalculator}}</a>
            </div>
            </div>

            <aside
              class='hero-dashboard'
              data-hero-dashboard
              data-dashboard-mode='example'
              aria-label='{{hero.dashboardAriaLabel}}'
            >
              <div class='hero-dashboard__top'>
                <span class='hero-dashboard__location'><svg class='inline-icon' aria-hidden='true'><use
                      href='/icons.svg#map-pin'
                    ></use></svg><span data-hero-analysis-location>{{hero.dashboardExample.location}}</span></span>
                <span class='hero-dashboard__status' data-hero-analysis-status>{{hero.dashboardExample.status}}</span>
              </div>
              <p class='hero-dashboard__label' data-hero-analysis-label aria-live='polite'>{{hero.dashboardExample.label}}</p>
              <div class='hero-dashboard__production'>
                <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#sun'></use></svg>
                <span>{{hero.dashboardGeneration}}</span>
              </div>
              <div class='hero-dashboard__yield'>
                <div class='hero-dashboard__metric'><strong data-hero-analysis-generation data-hero-countup data-hero-countup-value='{{hero.dashboardExample.annualGenerationKwh}}'>{{hero.dashboardExample.annualGenerationDisplay}}</strong><span data-hero-analysis-generation-unit>{{hero.dashboardGenerationUnit}}</span></div>
                <div class='hero-dashboard__bars' data-hero-analysis-bars role='img' aria-label='{{hero.dashboardGeneration}}'>{{#each hero.dashboardExample.monthlyBarPercent}}<i style='--hero-bar-height: {{this}}%;'></i>{{/each}}</div>
              </div>
              <dl class='hero-dashboard__facts'>
                <div data-hero-example-co2><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#leaf'></use></svg><dt>{{hero.dashboardExample.co2Label}}</dt><dd><strong data-hero-example-co2-value data-hero-countup data-hero-countup-value='{{hero.dashboardExample.co2Tons}}' data-hero-countup-decimals='1'>{{hero.dashboardExample.co2Display}}</strong> <small>{{hero.dashboardCo2Unit}}</small></dd></div>
                <div data-hero-analysis-coverage hidden><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#shield-check'></use></svg><dt>{{hero.dashboardCoverage}}</dt><dd><strong data-hero-analysis-coverage-value>{{hero.dashboardNeedConsumption}}</strong> <small data-hero-analysis-coverage-unit hidden>{{hero.dashboardCoverageUnit}}</small></dd></div>
                <div data-hero-analysis-savings hidden><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#zap'></use></svg><dt>{{hero.dashboardSavings}}</dt><dd><strong data-hero-analysis-savings-value>{{hero.dashboardNeedTariff}}</strong> <small data-hero-analysis-savings-unit hidden>{{hero.dashboardSavingsUnit}}</small></dd></div>
                <div data-hero-analysis-co2 hidden><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#leaf'></use></svg><dt>{{hero.dashboardCo2}}</dt><dd><strong data-hero-analysis-co2-value>—</strong> <small data-hero-analysis-co2-unit>{{hero.dashboardCo2Unit}}</small></dd></div>
                <div data-hero-example-trees><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#tree'></use></svg><dt>{{hero.dashboardExample.treesLabel}}</dt><dd><strong data-hero-example-trees-value data-hero-countup data-hero-countup-value='{{hero.dashboardExample.trees}}'>{{hero.dashboardExample.trees}}</strong> <small>{{hero.dashboardExample.treesUnit}}</small></dd></div>
              </dl>
              <p class='hero-dashboard__note'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#zap'></use></svg><span data-hero-analysis-note>{{hero.dashboardExample.note}}</span></p>
            </aside>
          </div>
          <p class='hero-signature' aria-hidden='true'><span>{{hero.signatureLead}}</span><span>{{hero.signatureTail}}</span><svg class='hero-signature__flourish' viewBox='0 0 126 18' focusable='false'><path d='M2 14c25-7 50-9 72-6 19 2 34 1 50-5'></path></svg></p>
          <aside class='trust-strip hero-trust-strip' aria-label='{{trust.disclosure}}'>
            <div class='container trust-strip__inner'>
              {{#each trust.items}}
                <div class='trust-item'><svg class='inline-icon' aria-hidden='true'><use
                      href='/icons.svg#{{icon}}'
                    ></use></svg><p><strong>{{title}}</strong><span>{{note}}</span></p></div>
              {{/each}}
              <a class='hero-scroll-cue' href='#passport' aria-label='{{trust.explore}}'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg><span>{{trust.explore}}</span></a>
            </div>
          </aside>
        </div>
      </section>

      <section
        class='passport section section--soft'
        id='passport'
        aria-labelledby='passport-title'
        tabindex='-1'
        data-passport-bridge
      >
        <svg class='passport-energy-bridge' viewBox='0 0 1600 440' preserveAspectRatio='none' aria-hidden='true' focusable='false'><path pathLength='1' d='M1220 0 C 1120 104, 980 156, 890 420'></path></svg>
        <div class='container passport-grid'>
          <div class='passport-copy'>
            <p class='eyebrow'>{{passport.eyebrow}}</p>
            <h2 id='passport-title'>{{passport.title}}</h2>
            <p>{{passport.copy}}</p>
            <ul class='check-list' role='list'>{{#each passport.features}}<li><svg
                    class='inline-icon'
                    aria-hidden='true'
                  ><use href='/icons.svg#check'></use></svg>{{this}}</li>{{/each}}</ul>
            <a
              class='button button--outline'
              href='{{calculatorHref}}'
            >{{passport.cta}}</a>
          </div>
          <article class='passport-card' aria-label='{{passport.title}}'>
            <div class='passport-card__top'><span class='wordmark wordmark--small'><span
              >YOUR</span><strong>ENERGY</strong></span><span
                class='pill'
              >{{passport.badge}}</span></div>
            <p class='passport-label'>{{passport.reportLabel}}</p>
            <h3>{{passport.reportAddress}}</h3>
            <p class='passport-date'>{{passport.reportDate}}</p>
            <div class='passport-card__visual'>
              <picture>
                <source
                  type='image/avif'
                  srcset='/images/roof-scan-480.avif 480w, /images/roof-scan-768.avif 768w'
                  sizes='(max-width: 680px) 90vw, 25vw'
                />
                <source
                  type='image/webp'
                  srcset='/images/roof-scan-480.webp 480w, /images/roof-scan-768.webp 768w'
                  sizes='(max-width: 680px) 90vw, 25vw'
                />
                <img
                  src='/images/roof-scan-768.jpg'
                  srcset='/images/roof-scan-480.jpg 480w, /images/roof-scan-768.jpg 768w'
                  sizes='(max-width: 680px) 90vw, 25vw'
                  width='768'
                  height='512'
                  alt='{{map.imageAlt}}'
                  loading='lazy'
                  decoding='async'
                />
              </picture>
              <span class='mini-panels' aria-hidden='true'></span><span class='demo-badge'>{{map.demo}}</span>
            </div>
            <dl class='passport-specs'>
              <div><dt>{{passport.system}}</dt><dd>{{passport.capacity}}</dd></div>
              <div><dt>{{passport.source}}</dt><dd>{{passport.panels}}</dd></div>
            </dl>
          </article>
          <div class='generation-card'>
            <h3>{{passport.chartTitle}}</h3>
            <p id='generation-chart-description'>{{passport.chartDescription}}</p>
            <div class='bar-chart' aria-describedby='generation-chart-description'>
              {{#each passport.months}}
                <button
                  class='chart-bar'
                  type='button'
                  style='--bar-height: {{percent}}%;'
                  title='{{short}} · {{name}}: {{value}} kWh'
                  aria-label='{{short}} · {{name}}: {{value}} kWh'
                ><span class='chart-bar__fill'></span><span>{{short}}</span></button>
              {{/each}}
            </div>
            <details class='chart-data'><summary>{{passport.tableTitle}}</summary><table><caption
                  class='visually-hidden'
                >{{passport.tableTitle}}</caption><thead><tr><th scope='col'>{{passport.monthLabel}}</th><th scope='col'>kWh</th></tr></thead><tbody
                >{{#each passport.months}}<tr><td>{{name}}</td><td>{{value}}</td></tr>{{/each}}</tbody></table></details>
          </div>
        </div>
      </section>
      <section class='solutions section' id='solutions' aria-labelledby='solutions-title' >
        <div class='container'>
          <div class='section-heading'><div><p class='eyebrow'>{{solutions.eyebrow}}</p><h2
                id='solutions-title'
              >{{solutions.title}}</h2></div><p>{{solutions.copy}}</p></div>
          <div class='solution-grid'>
            {{#each solutions.items}}
              <article class='solution-card {{cardClass}}'>
                {{#if badge}}<span class='solution-badge'>{{badge}}</span>{{/if}}
                <p class='solution-index'>0{{@index}}</p><h3>{{name}}</h3><p>{{subtitle}}</p>
                <dl><div><dt>kWp</dt><dd>{{capacity}}</dd></div><div><dt>kWh</dt><dd>{{generation}}</dd></div></dl>
                <strong class='solution-price'>{{price}}</strong>
                <details><summary>{{detailsLabel}}</summary><ul>{{#each details}}<li
                      >{{this}}</li>{{/each}}</ul></details>
                <a class='button {{buttonClass}}' href='{{../solutionHref}}'>{{ctaLabel}}</a>
              </article>
            {{/each}}
          </div>
          <p class='section-disclosure'>{{solutions.disclaimer}}</p>
        </div>
      </section>

      <section
        class='projects section section--soft'
        id='projects'
        aria-labelledby='projects-title'
      >
        <div class='container'>
          <div class='section-heading section-heading--actions'><div><p
                class='eyebrow'
              >{{projects.eyebrow}}</p><h2 id='projects-title'>{{projects.title}}</h2></div><p
            >{{projects.copy}}</p></div>
          <div class='projects-toolbar'><span>{{projects.imageNote}}</span><div><button
                class='round-button'
                type='button'
                data-project-direction='-1'
                aria-label='{{aria.previousProject}}'
              >←</button><button
                class='round-button'
                type='button'
                data-project-direction='1'
                aria-label='{{aria.nextProject}}'
              >→</button></div></div>
          <div class='projects-track' data-projects-track tabindex='0'>
            {{#each projects.items}}
              <article class='project-card {{cardClass}}'>
                <div class='project-image'><picture><source
                      type='image/avif'
                      srcset='{{avifSrcset}}'
                      sizes='{{imageSizes}}'
                    /><source
                      type='image/webp'
                      srcset='{{webpSrcset}}'
                      sizes='{{imageSizes}}'
                    /><img
                      src='/images/{{image}}-800.jpg'
                      width='800'
                      height='533'
                      alt='{{illustrativeLabel}}: {{city}}'
                      loading='lazy'
                      decoding='async'
                    /></picture><span class='demo-badge'>{{badgeLabel}}</span></div>
                <div class='project-card__body'><h3>{{city}}</h3><ul role='list'><li
                    >{{capacity}}</li><li>{{generation}}</li></ul></div>
              </article>
            {{/each}}
          </div>
        </div>
      </section>

      <section class='process section' id='process' aria-labelledby='process-title'>
        <div class='container'><div class='section-heading'><div><p
                class='eyebrow'
              >{{process.eyebrow}}</p><h2 id='process-title'>{{process.title}}</h2></div><p
            >{{process.note}}</p></div>
          <ol class='process-list'>{{#each process.steps}}<li><span>{{number}}</span><svg
                  class='inline-icon'
                  aria-hidden='true'
                ><use href='/icons.svg#{{icon}}'></use></svg><h3>{{title}}</h3><p
                >{{copy}}</p></li>{{/each}}</ol>
        </div>
      </section>

      <section class='engineering section' id='engineering' aria-labelledby='engineering-title'><div
          class='container engineering-grid'
        ><div class='engineering-photo'><picture><source
                type='image/avif'
                srcset='/images/engineer-onsite-480.avif 480w, /images/engineer-onsite-800.avif 800w, /images/engineer-onsite-1200.avif 1200w'
                sizes='(max-width: 760px) 100vw, 50vw'
              /><source
                type='image/webp'
                srcset='/images/engineer-onsite-480.webp 480w, /images/engineer-onsite-800.webp 800w, /images/engineer-onsite-1200.webp 1200w'
                sizes='(max-width: 760px) 100vw, 50vw'
              /><img
                src='/images/engineer-onsite-800.jpg'
                width='800'
                height='533'
                alt='{{engineering.imageAlt}}'
                loading='lazy'
                decoding='async'
              /></picture><span class='demo-badge'>{{common.illustrative}}</span><p
            >{{engineering.imageNote}}</p></div><div><p
              class='eyebrow'
            >{{engineering.eyebrow}}</p><h2 id='engineering-title'>{{engineering.title}}</h2><p
            >{{engineering.copy}}</p><ul class='check-list' role='list'>{{#each
                engineering.items
              }}<li><svg class='inline-icon' aria-hidden='true'><use
                      href='/icons.svg#check'
                    ></use></svg>{{this}}</li>{{/each}}</ul></div></div></section>

      <section class='company-record section section--soft' id='company-record' aria-labelledby='company-record-title'><div
          class='container'
        ><div class='company-record__heading'><div><p class='eyebrow'>{{companyRecord.eyebrow}}</p><h2
                id='company-record-title'
              >{{companyRecord.title}}</h2><p>{{companyRecord.copy}}</p></div><a
              class='button button--outline company-record__verify'
              href='https://verify.e-gov.am'
              target='_blank'
              rel='noopener'
            >{{companyRecord.action}} <svg class='inline-icon' aria-hidden='true'><use
                  href='/icons.svg#arrow-right'
                ></use></svg></a></div><dl class='company-record__facts'>{{#each
              companyRecord.facts
            }}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl><div class='company-record__meta'><p><svg
                class='inline-icon'
                aria-hidden='true'
              ><use href='/icons.svg#pin'></use></svg><span><strong>{{companyRecord.addressLabel}}</strong>{{companyRecord.address}}</span></p><p><svg
                class='inline-icon'
                aria-hidden='true'
              ><use href='/icons.svg#check'></use></svg><span>{{companyRecord.source}}<small>{{companyRecord.verification}}</small></span></p></div><p
            class='company-record__disclosure'
          >{{companyRecord.disclosure}}</p></div></section>

      <section class='equipment' aria-labelledby='equipment-title'><div class='container'><h2
            id='equipment-title'
          >{{equipment.title}}</h2><div class='brand-row' role='list'>{{#each
              equipment.brands
            }}<span role='listitem'>{{this}}</span>{{/each}}</div><p
          >{{equipment.note}}</p><div
            class='equipment-documents'
            id='equipment-documents'
            aria-labelledby='equipment-documents-title'
          ><div class='equipment-documents__heading'><h3
                id='equipment-documents-title'
              >{{equipment.documentsTitle}}</h3><p>{{equipment.documentsCopy}}</p></div><ul
              class='equipment-documents__grid'
              role='list'
            >{{#each equipment.documents}}<li class='equipment-document'><p
                  class='equipment-document__vendor'
                >{{vendor}}</p><h4>{{title}}</h4><dl>{{#each facts}}<div><dt>{{label}}</dt><dd
                      >{{value}}</dd></div>{{/each}}</dl><a
                  class='text-link equipment-document__link'
                  href='{{href}}'
                  type='application/pdf'
                  target='_blank'
                  rel='noopener'
                >{{../equipment.documentAction}} <svg class='inline-icon' aria-hidden='true'><use
                      href='/icons.svg#arrow-right'
                    ></use></svg></a><p class='equipment-document__note'>{{note}}</p></li>{{/each}}</ul><p
              class='equipment-documents__disclosure'
            >{{equipment.documentsDisclosure}}</p></div></div></section>

      <section class='faq section section--soft' id='faq' aria-labelledby='faq-title'><div
          class='container faq-layout'
        ><div><p class='eyebrow'>{{faq.eyebrow}}</p><h2 id='faq-title'>{{faq.title}}</h2></div><div
            class='faq-list'
          >{{#each faq.items}}<details><summary>{{question}}<span
                    aria-hidden='true'
                  >+</span></summary><p>{{answer}}</p></details>{{/each}}</div></div></section>

      <section class='final-cta section' id='final-cta' aria-labelledby='final-title'><div
          class='container final-cta__inner'
        ><div><p class='eyebrow eyebrow--dark'>YOURENERGY</p><h2
              id='final-title'
            >{{finalCta.title}}</h2><p>{{finalCta.copy}}</p></div><div class='final-cta__actions'><a
              class='button'
              href='{{calculatorHref}}'
            >{{finalCta.primary}}</a><small>{{finalCta.note}}</small></div></div></section>
    </main>

    {{> site-footer}}

    <script id='home-page-config' type='application/json'>{{{homePageConfig}}}</script>
    <script type='module' src='/src/main.js'></script>
  </body>
</html>
