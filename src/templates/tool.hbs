<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#071a2d' />
    <meta name='color-scheme' content='light' />
    <title>{{tool.meta.title}}</title>
    <meta name='description' content='{{tool.meta.description}}' />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:locale' content='{{localeCode}}' />
    <meta property='og:title' content='{{tool.meta.ogTitle}}' />
    <meta property='og:description' content='{{tool.meta.ogDescription}}' />
    <meta property='og:url' content='https://yourenergy.am{{path}}' />
    <meta property='og:image' content='https://yourenergy.am/og.png' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content='{{tool.meta.ogTitle}}' />
    <meta name='twitter:description' content='{{tool.meta.ogDescription}}' />
    <meta name='twitter:image' content='https://yourenergy.am/og.png' />
    <link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.svg' type='image/svg+xml' />
    <link rel='stylesheet' href='/src/styles/main.css' />
  </head>
  <body class='tool-page tool-page--offer-checker'>
    <a class='skip-link' href='#main'>{{shared.skip}}</a>
    <header class='site-header'>
      <div class='container header-row'>
        <a class='wordmark' href='{{homeHref}}' aria-label='YOURENERGY'><span>YOUR</span><strong
          >ENERGY</strong></a>
        <nav class='desktop-nav' aria-label='{{shared.primaryNav}}'>
          <a href='{{homeHref}}'>{{shared.home}}</a>
          <a href='{{calculatorHref}}'>{{shared.calculator}}</a>
          <a href='{{offerCheckerHref}}'>{{shared.offerChecker}}</a>
        </nav>
        <div class='header-actions'>
          <a class='header-phone' href='{{contact.phoneHref}}'><strong>{{contact.phone}}</strong><small
            >{{contact.hours}}</small></a>
          <nav class='language-switcher' aria-label='{{shared.language}}'>{{#each
              languageLinks
            }}<a
                class='language-link'
                href='{{href}}'
                hreflang='{{hreflang}}'
                aria-label='{{label}} — {{name}}'
              >{{label}}</a>{{/each}}</nav>
        </div>
        <details class='mobile-menu'>
          <summary aria-label='{{shared.menu}}'><span></span><span></span><span></span></summary>
          <nav aria-label='{{shared.mobileNav}}'>
            <a href='{{homeHref}}'>{{shared.home}}</a>
            <a href='{{calculatorHref}}'>{{shared.calculator}}</a>
            <a href='{{offerCheckerHref}}'>{{shared.offerChecker}}</a>
            <a href='{{contact.phoneHref}}'>{{shared.phone}}</a>
            <div class='mobile-language-switcher'>{{#each languageLinks}}<a
                  class='language-link'
                  href='{{href}}'
                  hreflang='{{hreflang}}'
                  aria-label='{{label}} — {{name}}'
                >{{label}}</a>{{/each}}</div>
          </nav>
        </details>
      </div>
    </header>

    <main id='main' class='tool-main'>
      <section class='tool-hero' aria-labelledby='tool-title'>
        <div class='container tool-hero__grid'>
          <div>
            <p class='eyebrow'>{{tool.label}}</p>
            <h1 id='tool-title'>{{tool.title}}</h1>
            <p class='tool-intro'>{{tool.intro}}</p>
            <p class='tool-privacy'>{{tool.privacy}}</p>
          </div>
          <aside class='tool-reference' aria-label='{{tool.referenceTitle}}'>
            <p class='eyebrow'>{{tool.referenceTitle}}</p>
            <strong data-pricebook-reference>{{tool.priceBookCheck}}</strong>
            <small data-pricebook-version hidden></small>
            <p>{{tool.referenceCopy}}</p>
          </aside>
        </div>
      </section>

      <section class='tool-workspace section' aria-labelledby='offer-form-title'>
        <div class='container tool-workspace__grid'>
          <form class='tool-form' data-offer-checker novalidate>
            <h2 id='offer-form-title'>{{tool.formTitle}}</h2>
            <label for='offer-total'>{{tool.totalLabel}}</label>
            <div class='tool-input-unit'>
              <input
                id='offer-total'
                name='totalAmd'
                type='number'
                min='1'
                max='1000000000'
                step='1'
                inputmode='decimal'
                required
              />
              <span>֏</span>
            </div>

            <label for='offer-capacity'>{{tool.capacityLabel}}</label>
            <div class='tool-input-unit'>
              <input
                id='offer-capacity'
                name='capacityKwp'
                type='number'
                min='0.01'
                max='10000'
                step='0.01'
                inputmode='decimal'
                required
              />
              <span>kWp</span>
            </div>

            <label for='offer-region'>{{tool.regionLabel}}</label>
            <select id='offer-region' name='region'>
              <option value='AM'>{{tool.regionArmenia}}</option>
            </select>

            <label for='offer-system'>{{tool.systemLabel}}</label>
            <select id='offer-system' name='systemType'>
              <option value='residential-grid-tied'>{{tool.systemGrid}}</option>
              <option value='battery'>{{tool.systemBattery}}</option>
              <option value='other'>{{tool.systemOther}}</option>
            </select>

            <fieldset class='offer-scope'>
              <legend>{{tool.scopeLegend}}</legend>
              <p>{{tool.scopeHelp}}</p>
              {{#each scopeItems}}<label><input
                  type='checkbox'
                  name='{{name}}'
                  value='true'
                /><span>{{label}}</span></label>{{/each}}
            </fieldset>

            <p class='form-status' data-tool-status aria-live='polite' role='status'></p>
            <div class='tool-form-actions'>
              <button class='button button--navy' type='submit'>{{tool.submit}}</button>
              <button class='button button--outline' type='reset'>{{tool.reset}}</button>
            </div>
            <noscript>
              <div class='tool-no-js'>
                <strong>{{tool.noJsTitle}}</strong>
                <p>{{tool.noJsCopy}}</p>
                <a class='button' href='{{contact.phoneHref}}'>{{shared.phone}}</a>
              </div>
            </noscript>
          </form>

          <section
            class='tool-result'
            data-offer-result
            aria-labelledby='offer-result-title'
            aria-live='polite'
            tabindex='-1'
          >
            <p class='eyebrow'>{{tool.label}}</p>
            <h2 id='offer-result-title'>{{tool.resultTitle}}</h2>
            <p data-offer-result-summary>{{tool.resultAwaiting}}</p>
            <dl data-offer-metrics hidden>
              <div><dt>{{tool.resultRate}}</dt><dd data-offer-rate>—</dd></div>
              <div><dt>{{tool.resultRange}}</dt><dd data-offer-range>—</dd></div>
            </dl>
            <div data-offer-why hidden>
              <h3>{{tool.resultWhy}}</h3>
              <ul data-offer-reasons></ul>
            </div>
            <div data-offer-questions hidden>
              <h3>{{tool.resultQuestions}}</h3>
              <ul data-offer-questions-list></ul>
            </div>
            <a class='button' data-engineering-cta hidden href='{{contact.phoneHref}}'>{{tool.engineeringCta}}</a>
          </section>
        </div>
      </section>
    </main>

    <footer class='tool-footer'>
      <div class='container'>
        <p>{{shared.footer}}</p>
        <a href='{{contact.phoneHref}}'>{{contact.phone}}</a>
      </div>
    </footer>

    <script id='tool-page-config' type='application/json'>{{{pageConfig}}}</script>
    <script type='module' src='/src/tools.js'></script>
  </body>
</html>
