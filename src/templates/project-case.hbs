<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#071a2d' />
    <meta name='color-scheme' content='light' />
    <title>{{meta.title}}</title>
    <meta name='description' content='{{meta.description}}' />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:locale' content='{{localeCode}}' />
    <meta property='og:title' content='{{meta.ogTitle}}' />
    <meta property='og:description' content='{{meta.ogDescription}}' />
    <meta property='og:url' content='https://yourenergy.am{{path}}' />
    <meta property='og:image' content='https://yourenergy.am/images/project-arabkir-1200.jpg' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content='{{meta.ogTitle}}' />
    <meta name='twitter:description' content='{{meta.ogDescription}}' />
    <meta name='twitter:image' content='https://yourenergy.am/images/project-arabkir-1200.jpg' />
    <link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' href='/yourenergy-mark.svg' type='image/svg+xml' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />
    <link rel='stylesheet' href='/src/styles/projects.css' />
  </head>
  <body class='page-projects page-project-case'>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>
    {{> site-header}}

    <main id='main'>
      <section class='project-case-hero' aria-labelledby='project-case-title'>
        <div class='container'>
          <a class='project-case__back' href='{{projectCase.projectsHref}}'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-left'></use></svg>{{projectCase.back}}</a>
          <div class='project-case-hero__grid'>
            <div class='project-case-hero__copy'>
              <p class='project-case__category'>{{projectCase.category}}</p>
              <p class='projects-location'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#map-pin'></use></svg>{{projectCase.location}}</p>
              <h1 id='project-case-title'>{{projectCase.title}}</h1>
              <p class='project-case__intro'>{{projectCase.intro}}</p>
              <a class='projects-primary-button' href='{{projectCase.calculatorHref}}'><span>{{projectCase.calculatorAction}}</span><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a>
            </div>
            <figure class='project-case__photo'>
              <picture><source type='image/avif' srcset='{{projectCase.avifSrcset}}' sizes='(max-width: 820px) 100vw, 50vw' /><source type='image/webp' srcset='{{projectCase.webpSrcset}}' sizes='(max-width: 820px) 100vw, 50vw' /><img src='/images/{{projectCase.image}}-800.jpg' width='800' height='533' alt='{{projectCase.imageAlt}}' fetchpriority='high' decoding='async' /></picture>
              <figcaption>{{projectCase.photoCaption}}</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class='project-case-results section' aria-labelledby='project-case-results-title'>
        <div class='container'>
          <h2 id='project-case-results-title'>{{projectCase.metricsTitle}}</h2>
          <dl class='project-case__metrics'>{{#each projectCase.metrics}}<div><dt><span><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#{{icon}}'></use></svg></span>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl>
        </div>
      </section>

      <section class='project-case-record section' aria-labelledby='project-case-record-title'>
        <div class='container'>
          <div class='project-case-record__heading'><h2 id='project-case-record-title'>{{projectCase.recordsTitle}}</h2></div>
          <dl class='project-case__record'>{{#each projectCase.records}}<div><dt>{{label}}</dt><dd>{{value}}</dd><p>{{note}}</p></div>{{/each}}</dl>
          <aside class='project-case__disclosure' aria-labelledby='project-case-disclosure-title'><h2 id='project-case-disclosure-title'>{{projectCase.disclosureTitle}}</h2><p>{{projectCase.disclosure}}</p></aside>
        </div>
      </section>
    </main>
    {{> site-footer}}
    <script type='module' src='/src/main.js'></script>
  </body>
</html>
