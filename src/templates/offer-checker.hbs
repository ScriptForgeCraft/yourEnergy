<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' /><meta name='viewport' content='width=device-width, initial-scale=1.0' /><meta name='theme-color' content='#071a2d' />
    <title>{{meta.title}}</title><meta name='description' content='{{meta.description}}' />
    <meta property='og:type' content='website' /><meta property='og:site_name' content='YOURENERGY' /><meta property='og:title' content='{{meta.ogTitle}}' /><meta property='og:description' content='{{meta.ogDescription}}' /><meta property='og:url' content='https://yourenergy.am{{path}}' /><meta property='og:image' content='https://yourenergy.am/og.png' /><meta name='twitter:card' content='summary_large_image' />
    <link rel='canonical' href='https://yourenergy.am{{path}}' />{{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' /><link rel='icon' href='/yourenergy-mark.svg' type='image/svg+xml' /><link rel='apple-touch-icon' href='/apple-touch-icon.png' /><link rel='stylesheet' href='/src/styles/tools-page.css' />
  </head>
  <body class='tool-page'>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>{{> site-header}}
    <main id='main'><section class='tool-hero section'><div class='container tool-hero__inner'><p class='eyebrow'>{{offerChecker.label}}</p><h1>{{offerChecker.title}}</h1><p>{{offerChecker.intro}}</p><p class='section-disclosure'>{{offerChecker.privacy}}</p></div></section>
      <section class='tool-workspace section'><div class='container tool-workspace__grid'><form class='tool-form' data-offer-checker novalidate aria-labelledby='offer-form-title'><h2 id='offer-form-title'>{{offerChecker.formTitle}}</h2><label>{{offerChecker.totalLabel}}<div class='input-with-unit'><input name='totalAmd' type='number' min='1' step='1000' inputmode='numeric' required /><span>AMD</span></div></label><label>{{offerChecker.capacityLabel}}<div class='input-with-unit'><input name='capacityKwp' type='number' min='0.1' step='0.01' inputmode='decimal' required /><span>kWp</span></div></label><label>{{offerChecker.regionLabel}}<select name='region'><option value='AM'>{{offerChecker.regionArmenia}}</option></select></label><label>{{offerChecker.systemLabel}}<select name='systemType'><option value='residential-grid-tied'>{{offerChecker.systemGrid}}</option><option value='battery'>{{offerChecker.systemBattery}}</option><option value='other'>{{offerChecker.systemOther}}</option></select></label><fieldset><legend>{{offerChecker.scopeLegend}}</legend><p class='input-help'>{{offerChecker.scopeHelp}}</p>{{#each offerCheckerScopeItems}}<label><input name='{{name}}' type='checkbox' value='true' /> {{label}}</label>{{/each}}</fieldset><p class='form-status' data-tool-status aria-live='polite'></p><div class='flow-actions'><button class='button' type='submit'>{{offerChecker.submit}}</button><button class='button button--outline' type='reset'>{{offerChecker.reset}}</button></div></form>
        <section class='tool-result' data-offer-result aria-labelledby='offer-result-title' aria-live='polite' tabindex='-1'><p class='eyebrow'>{{offerChecker.label}}</p><h2 id='offer-result-title'>{{offerChecker.resultTitle}}</h2><p data-offer-result-summary>{{offerChecker.resultAwaiting}}</p><dl data-offer-metrics hidden><div><dt>{{offerChecker.resultRate}}</dt><dd data-offer-rate>—</dd></div><div><dt>{{offerChecker.resultRange}}</dt><dd data-offer-range>—</dd></div></dl><div data-offer-why hidden><h3>{{offerChecker.resultWhy}}</h3><ul data-offer-reasons></ul></div><div data-offer-questions hidden><h3>{{offerChecker.resultQuestions}}</h3><ul data-offer-questions-list></ul></div><a class='button button--outline' href='{{contact.phoneHref}}' data-engineering-cta hidden>{{offerChecker.engineeringCta}}</a><aside class='pricebook-reference'><h3>{{offerChecker.referenceTitle}}</h3><p>{{offerChecker.referenceCopy}}</p><strong data-pricebook-reference></strong><small data-pricebook-version></small><p>{{offerChecker.priceBookCheck}}</p></aside></section></div></section>
    </main>{{> site-footer}}
    <noscript><section class='section'><div class='container'><h2>{{offerChecker.noJsTitle}}</h2><p>{{offerChecker.noJsCopy}}</p></div></section></noscript>
    <script id='page-config' type='application/json'>{{{pageConfig}}}</script><script type='module' src='/src/main.js'></script>
  </body>
</html>
