<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' /><meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#071a2d' /><title>{{meta.title}}</title>
    <meta name='description' content='{{meta.description}}' /><meta property='og:type' content='website' /><meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:title' content='{{meta.ogTitle}}' /><meta property='og:description' content='{{meta.ogDescription}}' /><meta property='og:url' content='https://yourenergy.am{{path}}' /><meta property='og:image' content='https://yourenergy.am/og.png' />
    <meta name='twitter:card' content='summary_large_image' /><link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.svg' type='image/svg+xml' /><link rel='stylesheet' href='/src/styles/main.css' />
    <script type='application/ld+json'>{{{jsonLd}}}</script>
  </head>
  <body class='calculator-page calculator-page--quick'>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>{{> site-header}}
    <main id='main'>
      <section class='tool-hero section'><div class='container tool-hero__inner'><p class='eyebrow'>{{quick.eyebrow}}</p><h1>{{quick.title}}</h1><p>{{quick.intro}}</p></div></section>
      <section class='quick-calculator section' id='quick-calculator' data-quick-calculator><div class='container quick-calculator__grid'>
        <form class='tool-form quick-calculator__form' data-quick-form novalidate aria-describedby='quick-status'>
          <h2>{{toolShared.calculator}}</h2>
          <label for='quick-region'>{{quick.region}}<select id='quick-region' data-quick-region required><option value=''>—</option>{{#each regions}}<option value='{{id}}'>{{label}}</option>{{/each}}</select></label>
          <fieldset><legend>{{quick.mode}}</legend><label><input type='radio' name='quick-consumption-mode' value='bill' checked /> {{quick.bill}}</label><label><input type='radio' name='quick-consumption-mode' value='usage' /> {{quick.usage}}</label></fieldset>
          <label data-quick-bill-wrap for='quick-bill'>{{quick.billLabel}}<div class='input-with-unit'><input id='quick-bill' type='number' min='0.01' step='1' inputmode='decimal' data-quick-bill /><span>AMD</span></div></label>
          <label data-quick-usage-wrap for='quick-usage' hidden>{{quick.usageLabel}}<div class='input-with-unit'><input id='quick-usage' type='number' min='0.01' step='1' inputmode='decimal' data-quick-usage /><span>kWh</span></div></label>
          <div data-quick-tariff-wrap hidden><label for='quick-tariff'><span data-quick-tariff-label>{{quick.tariffLabel}}</span><div class='input-with-unit'><input id='quick-tariff' type='number' min='0.01' step='0.01' inputmode='decimal' data-quick-tariff required aria-required='true' aria-describedby='quick-tariff-help' /><span>AMD/kWh</span></div></label><p class='input-help' id='quick-tariff-help' data-quick-tariff-help>{{quick.tariffHelp}}</p></div>
          <button class='button' type='submit' data-quick-submit>{{quick.submit}}</button><p class='form-status' id='quick-status' data-quick-status aria-live='polite'></p>
        </form>
        <section class='tool-result quick-result' data-quick-result aria-live='polite' aria-labelledby='quick-result-title'><p class='eyebrow'>{{quick.regional}}</p><h2 id='quick-result-title'>{{quick.waiting}}</h2><p data-quick-result-copy>{{quick.regionalCopy}}</p><div data-quick-result-values hidden></div><div class='quick-result__actions' data-quick-result-actions hidden><button class='button' type='button' data-quick-lead-open>{{quick.contact}}</button><a class='button button--outline' href='{{refineHref}}'>{{quick.refine}}</a><a class='text-link' href='{{contact.phoneHref}}'>{{quick.phone}}</a></div><p class='quick-result__links' data-quick-result-links hidden><a class='text-link' href='{{offerCheckerHref}}'>{{quick.offer}}</a><a class='text-link' href='{{proHref}}'>{{quick.pro}}</a></p><p class='section-disclosure'>{{quick.disclaimer}}</p>
          <dialog class='quick-lead-dialog' data-quick-lead-dialog aria-labelledby='quick-lead-title' aria-describedby='quick-lead-copy'>
            <button class='round-button dialog-close' type='button' data-quick-lead-close aria-label='{{aria.close}}'>×</button>
            <div class='dialog-content'><p class='eyebrow'>{{quick.lead.eyebrow}}</p><h2 id='quick-lead-title'>{{quick.lead.title}}</h2><p id='quick-lead-copy'>{{quick.lead.copy}}</p>
              <form data-quick-lead-form novalidate aria-describedby='quick-lead-status'>
                <label for='quick-lead-name'>{{quick.lead.name}}<input id='quick-lead-name' data-quick-lead-name autocomplete='name' maxlength='100' required /></label>
                <label for='quick-lead-phone'>{{quick.lead.phone}}<input id='quick-lead-phone' data-quick-lead-phone type='tel' autocomplete='tel' inputmode='tel' maxlength='32' required /></label>
                <label for='quick-lead-message'>{{quick.lead.comment}} <span>{{product.common.optional}}</span><textarea id='quick-lead-message' data-quick-lead-message maxlength='2000' rows='3'></textarea></label>
                <button class='button' type='submit' data-quick-lead-submit>{{quick.lead.submit}}</button><p class='form-status' id='quick-lead-status' data-quick-lead-status aria-live='polite'></p>
              </form>
              <div data-quick-lead-success hidden><p class='form-status is-success'>{{quick.lead.success}}</p><button class='button button--outline' type='button' data-quick-lead-close>{{quick.lead.close}}</button></div>
            </div>
          </dialog>
        </section>
      </div></section>
      <noscript><section class='section section--soft'><div class='container'><h2>{{toolShared.calculator}}</h2><p>{{quick.noJs}}</p><a class='button' href='{{contact.phoneHref}}'>{{contact.phone}}</a></div></section></noscript>
    </main>
    {{> site-footer}}
    <script id='page-config' type='application/json'>{{{pageConfig}}}</script><script type='module' src='/src/main.js'></script>
  </body>
</html>
