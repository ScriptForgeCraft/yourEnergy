<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' /><meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#071a2d' /><title>{{meta.title}}</title>
    <meta name='description' content='{{meta.description}}' /><meta property='og:type' content='website' /><meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:title' content='{{meta.ogTitle}}' /><meta property='og:description' content='{{meta.ogDescription}}' /><meta property='og:url' content='https://yourenergy.am{{path}}' /><meta property='og:image' content='https://yourenergy.am/og.png' />
    <meta name='twitter:card' content='summary_large_image' /><link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' /><link rel='icon' href='/yourenergy-mark.svg' type='image/svg+xml' /><link rel='apple-touch-icon' href='/apple-touch-icon.png' /><link rel='stylesheet' href='/src/styles/tools-page.css' />
    <script type='application/ld+json'>{{{jsonLd}}}</script>
  </head>
  <body class='calculator-page calculator-page--quick'>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>{{> site-header}}
    <main id='main'><div data-calculator-mode-stage data-professional-source='{{professionalShellHref}}' aria-live='polite'>
      <section class='calculator-hero calculator-hero--quick section'>
        <div class='calculator-hero__visual' aria-hidden='true'><picture><source type='image/avif' srcset='/images/hero-time-16-1024.avif 1024w, /images/hero-time-16-1600.avif 1600w' sizes='(max-width: 780px) 0px, 72vw' /><source type='image/webp' srcset='/images/hero-time-16-1024.webp 1024w, /images/hero-time-16-1600.webp 1600w' sizes='(max-width: 780px) 0px, 72vw' /><img src='/images/hero-time-16-1600.jpg' width='1600' height='900' alt='' /></picture></div>
        <div class='container calculator-hero__inner'><p class='calculator-hero__eyebrow'>{{modeControl.eyebrow}}</p><h1>{{quick.heroTitle}}</h1><p>{{quick.intro}}</p><nav class='calculator-mode-switch' aria-label='{{modeControl.label}}'><a class='is-active' aria-current='page' data-calculator-mode='quick' href='{{calculatorHref}}'><strong>{{modeControl.quick}}</strong><span>{{modeControl.quickCopy}}</span></a><a data-calculator-mode='professional' href='{{{professionalHref}}}'><strong>{{modeControl.professional}}</strong><span>{{modeControl.professionalCopy}}</span></a></nav></div>
      </section>
      <section class='quick-calculator section' id='quick-calculator' data-quick-calculator><div class='container quick-calculator__grid'>
        <form class='tool-form quick-calculator__form' data-quick-form novalidate aria-describedby='quick-status'>
          <div class='quick-step'>
            <div class='quick-step__heading'><span class='quick-step__number' aria-hidden='true'>1</span><div><h2>{{quick.locationTitle}}</h2><p>{{quick.locationCopy}}</p></div></div>
            <label class='quick-field' for='quick-region'><span>{{quick.region}}</span><select id='quick-region' data-quick-region required><option value=''>—</option>{{#each regions}}<option value='{{id}}'>{{label}}</option>{{/each}}</select></label>
          </div>
          <div class='quick-step'>
            <div class='quick-step__heading'><span class='quick-step__number' aria-hidden='true'>2</span><div><h2>{{quick.consumptionTitle}}</h2><p>{{quick.consumptionCopy}}</p></div></div>
            <fieldset class='quick-mode-fieldset'><legend>{{quick.mode}}</legend><div class='quick-mode-options'><label class='quick-mode-option'><input type='radio' name='quick-consumption-mode' value='bill' checked /><span><strong>{{quick.bill}}</strong><small>AMD</small></span></label><label class='quick-mode-option'><input type='radio' name='quick-consumption-mode' value='usage' /><span><strong>{{quick.usage}}</strong><small>kWh</small></span></label></div></fieldset>
            <label class='quick-field' data-quick-bill-wrap for='quick-bill'><span>{{quick.billLabel}}</span><div class='input-with-unit'><input id='quick-bill' type='number' min='0.01' step='1' inputmode='decimal' data-quick-bill /><span>AMD</span></div></label>
            <label class='quick-field' data-quick-usage-wrap for='quick-usage' hidden><span>{{quick.usageLabel}}</span><div class='input-with-unit'><input id='quick-usage' type='number' min='0.01' step='1' inputmode='decimal' data-quick-usage /><span>kWh</span></div></label>
            <div class='quick-tariff' data-quick-tariff-wrap hidden><label class='quick-field' for='quick-tariff-select'><span data-quick-tariff-label>{{quick.tariffLabel}}</span><select id='quick-tariff-select' data-quick-tariff-select aria-describedby='quick-tariff-help'></select></label><p class='input-help' id='quick-tariff-help' data-quick-tariff-help></p><p class='input-help' data-quick-tariff-suggestion hidden></p><label class='quick-field' data-quick-custom-tariff-wrap for='quick-tariff' hidden><span data-quick-custom-tariff-label>{{quick.customTariffLabel}}</span><div class='input-with-unit'><input id='quick-tariff' type='number' min='0.01' step='0.01' inputmode='decimal' data-quick-tariff aria-describedby='quick-tariff-help' /><span>AMD/kWh</span></div></label></div>
          </div>
          <button class='button' type='submit' data-quick-submit>{{quick.submit}}</button><p class='form-status' id='quick-status' data-quick-status aria-live='polite'></p>
        </form>
        <section class='tool-result quick-result' data-quick-result aria-live='polite' aria-labelledby='quick-result-title'><div class='quick-result__heading'><div><p class='result-kicker'>{{modeControl.quick}}</p><h2 id='quick-result-title'>{{quick.resultsTitle}}</h2><p data-quick-result-copy>{{quick.waiting}}</p></div><span class='quick-result__scope'>{{quick.regional}}</span></div><div data-quick-result-values hidden></div><div class='quick-result__actions' data-quick-result-actions hidden><button class='button' type='button' data-quick-lead-open>{{quick.contact}}</button><a class='button button--outline' data-calculator-mode='professional' href='{{{professionalHref}}}'>{{quick.pro}}</a><a class='text-link' href='{{contact.phoneHref}}'>{{quick.phone}}</a></div><p class='quick-result__links' data-quick-result-links hidden><a class='text-link' data-calculator-mode='professional' href='{{{professionalHref}}}'>{{quick.pro}}</a></p><p class='section-disclosure'>{{quick.disclaimer}}</p>
          <dialog class='quick-lead-dialog' data-quick-lead-dialog aria-labelledby='quick-lead-title' aria-describedby='quick-lead-copy'>
            <button class='round-button dialog-close' type='button' data-quick-lead-close aria-label='{{aria.close}}'>×</button>
            <div class='dialog-content'><h2 id='quick-lead-title'>{{quick.lead.title}}</h2><p id='quick-lead-copy'>{{quick.lead.copy}}</p>
              <form data-quick-lead-form novalidate aria-describedby='quick-lead-status'>
                <label for='quick-lead-name'>{{quick.lead.name}}<input id='quick-lead-name' data-quick-lead-name autocomplete='name' maxlength='100' required /></label>
                <label for='quick-lead-phone'>{{quick.lead.phone}}<input id='quick-lead-phone' data-quick-lead-phone type='tel' autocomplete='tel' inputmode='tel' maxlength='32' required /></label>
                <label for='quick-lead-message'>{{quick.lead.comment}} <span>{{product.common.optional}}</span><textarea id='quick-lead-message' data-quick-lead-message maxlength='2000' rows='3'></textarea></label>
                <button class='button' type='submit' data-quick-lead-submit>{{quick.lead.submit}}</button><p class='form-status' id='quick-lead-status' data-quick-lead-status aria-live='polite'></p>
              </form>
              <div data-quick-lead-success hidden><p class='form-status is-success'>{{quick.lead.success}}</p><button class='button button--outline' type='button' data-quick-lead-close>{{quick.lead.close}}</button></div>
            </div>
          </dialog>
        </section>
      </div></section>
      <noscript><section class='section section--soft'><div class='container'><h2>{{toolShared.calculator}}</h2><p>{{quick.noJs}}</p><a class='button' href='{{contact.phoneHref}}'>{{contact.phone}}</a></div></section></noscript>
    </div></main>
    {{> site-footer}}
    <script id='page-config' type='application/json'>{{{pageConfig}}}</script><script type='module' src='/src/main.js'></script>
  </body>
</html>
