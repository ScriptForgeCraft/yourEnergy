<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='robots' content='noindex,follow' />
    <meta name='theme-color' content='#071a2d' />
    <meta name='color-scheme' content='light' />
    <title>{{contactPage.meta.title}}</title>
    <meta name='description' content='{{contactPage.meta.description}}' />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:locale' content='{{localeCode}}' />
    <meta property='og:title' content='{{contactPage.meta.ogTitle}}' />
    <meta property='og:description' content='{{contactPage.meta.ogDescription}}' />
    <meta property='og:url' content='https://yourenergy.am{{path}}' />
    <meta property='og:image' content='https://yourenergy.am/og.png' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content='{{contactPage.meta.ogTitle}}' />
    <meta name='twitter:description' content='{{contactPage.meta.ogDescription}}' />
    <meta name='twitter:image' content='https://yourenergy.am/og.png' />
    <link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' href='/yourenergy-mark.svg' type='image/svg+xml' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />
    <link rel='stylesheet' href='/src/styles/contacts.css' />
  </head>
  <body class='contacts-page'>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>
    {{> site-header}}
    <main id='main'>
      <section class='contacts-hero' aria-labelledby='contacts-title'>
        <div class='contacts-hero__backdrop' aria-hidden='true'><picture><source
              type='image/avif'
              srcset='/images/hero-time-14-1024.avif 1024w, /images/hero-time-14-1600.avif 1600w'
              sizes='100vw'
            /><source
              type='image/webp'
              srcset='/images/hero-time-14-1024.webp 1024w, /images/hero-time-14-1600.webp 1600w'
              sizes='100vw'
            /><img src='/images/hero-time-14-1600.jpg' width='1600' height='900' alt='' /></picture></div>
        <div class='container contacts-hero__inner'>
          <div class='contacts-hero__copy'><h1 id='contacts-title'>{{{contactPage.title}}}</h1><p>{{contactPage.intro}}</p></div>
          <aside class='contacts-hero__signature' aria-label='YOURENERGY'><p>{{contactPage.signature}}</p><span aria-hidden='true'></span></aside>
          <div class='contacts-channels'>{{#each contactPage.channels}}<a
                class='contacts-channel'
                href='{{href}}'
                {{#if meeting}}data-meeting-open{{/if}}
                {{#if external}}target='_blank' rel='noopener noreferrer'{{/if}}
              ><span class='contacts-channel__icon'><svg aria-hidden='true'><use href='/icons.svg#{{icon}}'></use></svg></span><span><strong>{{title}}</strong><small>{{value}}</small></span></a>{{/each}}</div>
        </div>
      </section>

      <section class='contact-offices section' aria-labelledby='offices-title'>
        <div class='container'><header class='contact-section-heading'><div><h2 id='offices-title'>{{contactPage.officesTitle}}</h2><p>{{contactPage.officesIntro}}</p></div><a class='contact-route-button' href='{{contactPage.offices.0.href}}' target='_blank' rel='noopener noreferrer'><svg aria-hidden='true'><use href='/icons.svg#map-pin'></use></svg>{{contactPage.route}}</a></header>
          <div class='office-map' data-office-map aria-label='{{contactPage.officesTitle}}'><div class='office-map__canvas' data-office-map-canvas aria-hidden='true'></div>{{#each contactPage.offices}}<article class='office-card office-card--{{add @index 1}}' data-office-card data-office-map-lat='{{latitude}}' data-office-map-lng='{{longitude}}' data-office-map-title='{{title}}' data-office-map-address='{{address}}'><div class='office-card__image' aria-hidden='true'></div><div><h3>{{title}}</h3><p><svg aria-hidden='true'><use href='/icons.svg#map-pin'></use></svg>{{address}}</p><p><svg aria-hidden='true'><use href='/icons.svg#support'></use></svg>{{hours}}</p><button class='office-card__show' type='button' data-office-map-option aria-pressed='false'><svg aria-hidden='true'><use href='/icons.svg#map-pin'></use></svg>{{../contactPage.showOnMap}}</button></div><a href='{{href}}' target='_blank' rel='noopener noreferrer' aria-label='{{../contactPage.route}} — {{title}}'><svg aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a></article>{{/each}}</div>
        </div>
      </section>

      <section class='contact-form-section section' aria-labelledby='contact-form-title'>
        <div class='container contact-form-layout'><div class='contact-form-copy'><h2 id='contact-form-title'>{{contactPage.formTitle}}</h2><p>{{contactPage.formIntro}}</p><form id='contact-form' class='contact-form' data-contact-form novalidate><div class='contact-form__fields'><label for='contact-name'><span>{{contactPage.name}}</span><input id='contact-name' name='name' type='text' autocomplete='name' maxlength='100' required placeholder='{{contactPage.name}} *' /></label><label for='contact-phone'><span>{{contactPage.phone}}</span><input id='contact-phone' name='phone' type='tel' autocomplete='tel' inputmode='tel' maxlength='32' required placeholder='{{contactPage.phone}} *' /></label><label for='contact-email'><span>{{contactPage.email}}</span><input id='contact-email' name='email' type='email' autocomplete='email' maxlength='254' placeholder='{{contactPage.email}}' /></label><label for='contact-topic'><span>{{contactPage.topic}}</span><select id='contact-topic' name='topic' autocomplete='off'><option value=''>{{contactPage.topic}}</option>{{#each contactPage.topicOptions}}<option value='{{this}}'>{{this}}</option>{{/each}}</select></label><label class='contact-form__message' for='contact-message'><span>{{contactPage.message}}</span><textarea id='contact-message' name='message' autocomplete='off' maxlength='2000' rows='5' placeholder='{{contactPage.message}}'></textarea></label></div><label class='contact-form__consent' for='contact-consent'><input id='contact-consent' name='consent' type='checkbox' autocomplete='off' required /><span>{{contactPage.consent.before}}<a href='{{privacyHref}}'>{{contactPage.consent.link}}</a>{{contactPage.consent.after}}</span></label><button class='contact-form__submit' type='submit' data-contact-submit><span>{{contactPage.submit}}</span><svg aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></button><p class='contact-form__status' data-contact-status aria-live='polite'></p><p class='contact-form__success' data-contact-success hidden tabindex='-1'>{{contactPage.success}}</p></form></div>
          <aside class='contact-energy-card'><picture><source type='image/avif' srcset='/images/hero-time-20-1024.avif 1024w, /images/hero-time-20-1600.avif 1600w' sizes='(max-width: 900px) 100vw, 42vw' /><source type='image/webp' srcset='/images/hero-time-20-1024.webp 1024w, /images/hero-time-20-1600.webp 1600w' sizes='(max-width: 900px) 100vw, 42vw' /><img src='/images/hero-time-20-1600.jpg' width='1600' height='900' alt='' /></picture><div><h2>{{contactPage.cardTitle}}</h2><p>{{contactPage.cardCopy}}</p></div></aside></div>
        <div class='container contact-benefits'>{{#each contactPage.benefits}}<article><span><svg aria-hidden='true'><use href='/icons.svg#{{icon}}'></use></svg></span><div><h3>{{title}}</h3><p>{{copy}}</p></div></article>{{/each}}</div>
      </section>
    </main>
    <dialog class='meeting-dialog' data-meeting-dialog aria-labelledby='meeting-dialog-title' aria-describedby='meeting-dialog-copy'>
      <button class='meeting-dialog__close' type='button' data-meeting-dialog-close aria-label='{{contactPage.meeting.close}}'>×</button>
      <div class='meeting-dialog__content'>
        <p class='meeting-dialog__eyebrow'>{{contactPage.meeting.title}}</p>
        <h2 id='meeting-dialog-title'>{{contactPage.meeting.title}}</h2>
        <p id='meeting-dialog-copy'>{{contactPage.meeting.copy}}</p>
        <section class='meeting-picker' data-meeting-date-step aria-labelledby='meeting-date-title'>
          <h3 id='meeting-date-title'>{{contactPage.meeting.selectDate}}</h3>
          <div class='meeting-calendar__toolbar'>
            <button type='button' data-meeting-calendar-previous aria-label='{{contactPage.meeting.previousMonth}}'>‹</button>
            <p data-meeting-calendar-month aria-live='polite'></p>
            <button type='button' data-meeting-calendar-next aria-label='{{contactPage.meeting.nextMonth}}'>›</button>
          </div>
          <div class='meeting-calendar__weekdays' data-meeting-calendar-weekdays aria-hidden='true'></div>
          <div class='meeting-calendar__days' data-meeting-calendar-days></div>
        </section>
        <section class='meeting-picker meeting-picker--time' data-meeting-time-step aria-labelledby='meeting-time-title' hidden>
          <h3 id='meeting-time-title'>{{contactPage.meeting.selectTime}}</h3>
          <p class='meeting-picker__date' data-meeting-selected-date></p>
          <div class='meeting-times' data-meeting-times role='group' aria-labelledby='meeting-time-title'></div>
        </section>
        <p class='meeting-dialog__selection' data-meeting-selection aria-live='polite'></p>
        <form class='meeting-picker contact-form' data-meeting-contact-step aria-labelledby='meeting-contact-title' hidden novalidate>
          <h3 id='meeting-contact-title'>{{contactPage.meeting.contactTitle}}</h3>
          <p class='meeting-picker__date'>{{contactPage.meeting.contactCopy}}</p>
          <div class='contact-form__fields'>
            <label for='meeting-name'><span>{{contactPage.name}}</span><input id='meeting-name' name='name' type='text' autocomplete='name' maxlength='100' required placeholder='{{contactPage.name}} *' /></label>
            <label for='meeting-phone'><span>{{contactPage.phone}}</span><input id='meeting-phone' name='phone' type='tel' autocomplete='tel' inputmode='tel' maxlength='32' required placeholder='{{contactPage.phone}} *' /></label>
          </div>
          <button class='contact-form__submit' type='submit' data-meeting-submit><span>{{contactPage.meeting.submit}}</span><svg aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></button>
          <p class='contact-form__status' data-meeting-status aria-live='polite'></p>
          <p class='contact-form__success' data-meeting-success hidden tabindex='-1'>{{contactPage.meeting.success}}</p>
        </form>
      </div>
    </dialog>
    {{> site-footer}}
    <script id='contact-page-config' type='application/json'>{{{contactPageConfig}}}</script>
    <script type='module' src='/src/main.js'></script>
  </body>
</html>
