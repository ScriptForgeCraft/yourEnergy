<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='robots' content='noindex,follow' />
    <meta name='theme-color' content='#071a2d' />
    <meta name='color-scheme' content='light' />
    <title>{{contactPage.meta.title}}</title>
    <meta name='description' content='{{contactPage.meta.description}}' />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:locale' content='{{localeCode}}' />
    <meta property='og:title' content='{{contactPage.meta.ogTitle}}' />
    <meta property='og:description' content='{{contactPage.meta.ogDescription}}' />
    <meta property='og:url' content='https://yourenergy.am{{path}}' />
    <meta property='og:image' content='https://yourenergy.am/og.png' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content='{{contactPage.meta.ogTitle}}' />
    <meta name='twitter:description' content='{{contactPage.meta.ogDescription}}' />
    <meta name='twitter:image' content='https://yourenergy.am/og.png' />
    <link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' href='/yourenergy-mark.svg' type='image/svg+xml' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />
    <link rel='stylesheet' href='/src/styles/contacts.css' />
  </head>
  <body class='contacts-page'>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>
    {{> site-header}}
    <main id='main'>
      <section class='contacts-hero' aria-labelledby='contacts-title'>
        <div class='contacts-hero__backdrop' aria-hidden='true'>
          <picture>
            <source type='image/avif' srcset='/images/hero-time-14-1024.avif 1024w, /images/hero-time-14-1600.avif 1600w' sizes='100vw' />
            <source type='image/webp' srcset='/images/hero-time-14-1024.webp 1024w, /images/hero-time-14-1600.webp 1600w' sizes='100vw' />
            <img src='/images/hero-time-14-1600.jpg' width='1600' height='900' alt='' fetchpriority='high' decoding='async' />
          </picture>
        </div>
        <div class='container contacts-hero__inner'>
          <div class='contacts-hero__copy'>
            <h1 id='contacts-title'>{{{contactPage.heroTitle}}}</h1>
            <p>{{contactPage.heroIntro}}</p>
          </div>
          <div class='contacts-channels'>
            {{#each contactPage.channels}}
              <a class='contacts-channel' href='{{href}}' {{#if meeting}}data-meeting-open{{/if}} {{#if external}}target='_blank' rel='noopener noreferrer'{{/if}}>
                <span class='contacts-channel__icon'><svg aria-hidden='true'><use href='/icons.svg#{{icon}}'></use></svg></span>
                <span class='contacts-channel__copy'><strong>{{title}}</strong><small>{{value}}</small></span>
                <span class='contacts-channel__arrow' aria-hidden='true'><svg><use href='/icons.svg#arrow-right'></use></svg></span>
              </a>
            {{/each}}
          </div>
        </div>
      </section>

      <section class='contact-form-section section' aria-labelledby='contact-form-title'>
        <div class='container contact-form-layout'>
          <aside class='contact-info-card'>
            <div class='contact-info-card__intro'>
              <h2>{{contactPage.contactCardTitle}}</h2>
              <p>{{contactPage.contactCardCopy}}</p>
            </div>
            <div class='contact-info-card__list'>
              <a href='{{contactPage.channels.0.href}}'>
                <span class='contact-info-card__icon'><svg aria-hidden='true'><use href='/icons.svg#phone'></use></svg></span>
                <span><strong>{{contactPage.contactLabels.phone}}</strong><b>{{contactPage.channels.0.value}}</b><small>{{contactPage.channels.0.title}}</small></span>
              </a>
              <a href='{{contactPage.channels.1.href}}'>
                <span class='contact-info-card__icon'><svg aria-hidden='true'><use href='/icons.svg#mail'></use></svg></span>
                <span><strong>{{contactPage.contactLabels.email}}</strong><b>{{contactPage.channels.1.value}}</b><small>{{contactPage.channels.1.title}}</small></span>
              </a>
              <a href='{{contactPage.offices.0.href}}' target='_blank' rel='noopener noreferrer'>
                <span class='contact-info-card__icon'><svg aria-hidden='true'><use href='/icons.svg#map-pin'></use></svg></span>
                <span><strong>{{contactPage.contactLabels.address}}</strong><b>{{contactPage.offices.0.address}}</b><small>{{contactPage.offices.0.title}}</small></span>
              </a>
              <div class='contact-info-card__row'>
                <span class='contact-info-card__icon'><svg aria-hidden='true'><use href='/icons.svg#calendar'></use></svg></span>
                <span><strong>{{contactPage.contactLabels.hours}}</strong><b>{{contactPage.offices.0.hours}}</b></span>
              </div>
            </div>
          </aside>

          <div class='contact-form-card'>
            <div data-contact-pre-submit>
              <h2 id='contact-form-title'>{{contactPage.formTitleRef}}</h2>
              <p class='contact-form-card__intro'>{{contactPage.formIntroRef}}</p>
              <form id='contact-form' class='contact-form' data-contact-form novalidate>
                <div class='contact-form__fields'>
                  <label for='contact-name'><span>{{contactPage.name}} *</span><input id='contact-name' name='name' type='text' autocomplete='name' maxlength='100' required placeholder='{{contactPage.name}}' /></label>
                  <label for='contact-phone'><span>{{contactPage.phone}} *</span><input id='contact-phone' name='phone' type='tel' autocomplete='tel' inputmode='tel' maxlength='32' required placeholder='+374 __ ___ __' /></label>
                  <label class='contact-form__wide' for='contact-email'><span>{{contactPage.email}}</span><input id='contact-email' name='email' type='email' autocomplete='email' maxlength='254' placeholder='name@email.com' /></label>
                </div>
                <fieldset class='contact-property-types'>
                  <legend>{{contactPage.propertyTypeLabel}}</legend>
                  <div class='contact-property-types__grid'>
                    {{#each contactPage.propertyTypes}}
                      <label class='contact-property-type'>
                        <input type='radio' name='topic' value='{{value}}' {{#if @first}}checked{{/if}} />
                        <span class='contact-property-type__body'><svg aria-hidden='true'><use href='/icons.svg#{{icon}}'></use></svg><b>{{label}}</b><span class='contact-property-type__check'><svg aria-hidden='true'><use href='/icons.svg#check'></use></svg></span></span>
                      </label>
                    {{/each}}
                  </div>
                </fieldset>
                <label class='contact-form__message' for='contact-message'><span>{{contactPage.message}}</span><textarea id='contact-message' name='message' autocomplete='off' maxlength='2000' rows='4' placeholder='{{contactPage.message}}'></textarea></label>
                <div class='contact-form__footer'>
                  <button class='contact-form__submit' type='submit' data-contact-submit><span>{{contactPage.submit}}</span><svg aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></button>
                  <label class='contact-form__consent' for='contact-consent'>
                    <input id='contact-consent' name='consent' type='checkbox' autocomplete='off' required />
                    <span class='contact-form__consent-icon'><svg aria-hidden='true'><use href='/icons.svg#shield-check'></use></svg></span>
                    <span>{{contactPage.consent.before}}<a href='{{privacyHref}}'>{{contactPage.consent.link}}</a>{{contactPage.consent.after}}. {{contactPage.privacyHint}}</span>
                  </label>
                </div>
                <p class='contact-form__status' data-contact-status aria-live='polite'></p>
              </form>
            </div>
            <section class='contact-form__success' data-contact-success hidden tabindex='-1' aria-labelledby='contact-success-title'><h2 id='contact-success-title'>{{contactPage.success.title}}</h2><p>{{contactPage.success.text}}</p><button class='contact-form__submit' type='button' data-contact-success-close>{{contactPage.success.close}}</button></section>
          </div>
        </div>
      </section>

      <section class='contact-offices section' aria-labelledby='offices-title'>
        <div class='container'>
          <header class='contact-section-heading'>
            <div><h2 id='offices-title'>{{contactPage.officesProjectsTitle}}</h2><p>{{contactPage.officesProjectsIntro}}</p></div>
          </header>
          <div class='office-map' data-office-map aria-label='{{contactPage.officesProjectsTitle}}'>
            <div class='office-map__canvas' data-office-map-canvas role='region' aria-label='{{contactPage.officesProjectsTitle}}'></div>
            <div class='contact-location-cards'>
              {{#each contactPage.offices}}
                <article class='contact-location-card' data-office-card data-office-map-lat='{{latitude}}' data-office-map-lng='{{longitude}}' data-office-map-title='{{title}}' data-office-map-address='{{address}}'>
                  <a class='contact-location-card__link' href='{{href}}' target='_blank' rel='noopener noreferrer' aria-label='{{../contactPage.route}} — {{title}}, {{address}}'>
                    <span class='contact-location-card__icon'><svg aria-hidden='true'><use href='/icons.svg#map-pin'></use></svg></span>
                    <span class='contact-location-card__copy'><strong>{{title}}</strong><span>{{address}}</span></span>
                    <span class='contact-location-card__action'><span>{{../contactPage.route}}</span><svg aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></span>
                  </a>
                </article>
              {{/each}}
            </div>
          </div>
        </div>
      </section>

      <section class='contact-calculator-cta section' aria-labelledby='contact-calculator-title'>
        <div class='container contact-calculator-cta__inner'>
          <span class='contact-calculator-cta__icon'><svg aria-hidden='true'><use href='/icons.svg#calculator'></use></svg></span>
          <div class='contact-calculator-cta__copy'><h2 id='contact-calculator-title'>{{contactPage.calculatorTitle}}</h2><p>{{contactPage.calculatorCopy}}</p></div>
          <a class='contact-calculator-cta__button' href='{{contactPage.calculatorHref}}'>{{contactPage.calculatorAction}}<svg aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a>
        </div>
      </section>
    </main>
    <dialog class='meeting-dialog' data-meeting-dialog aria-labelledby='meeting-dialog-title' aria-describedby='meeting-dialog-copy'>
      <div data-meeting-flow>
      <button class='meeting-dialog__close' type='button' data-meeting-dialog-close aria-label='{{contactPage.meeting.close}}'>×</button>
      <div class='meeting-dialog__content'>
        <button class='meeting-dialog__back' type='button' data-meeting-back hidden><span aria-hidden='true'>‹</span>{{contactPage.meeting.back}}</button>
        <p class='meeting-dialog__eyebrow'>{{contactPage.meeting.title}}</p>
        <h2 id='meeting-dialog-title'>{{contactPage.meeting.title}}</h2>
        <p id='meeting-dialog-copy'>{{contactPage.meeting.copy}}</p>
        <section class='meeting-picker' data-meeting-date-step aria-labelledby='meeting-date-title'>
          <h3 id='meeting-date-title'>{{contactPage.meeting.selectDate}}</h3>
          <div class='meeting-calendar__toolbar'>
            <button type='button' data-meeting-calendar-previous aria-label='{{contactPage.meeting.previousMonth}}'>‹</button>
            <p data-meeting-calendar-month aria-live='polite'></p>
            <button type='button' data-meeting-calendar-next aria-label='{{contactPage.meeting.nextMonth}}'>›</button>
          </div>
          <div class='meeting-calendar__weekdays' data-meeting-calendar-weekdays aria-hidden='true'></div>
          <div class='meeting-calendar__days' data-meeting-calendar-days></div>
        </section>
        <section class='meeting-picker meeting-picker--time' data-meeting-time-step aria-labelledby='meeting-time-title' hidden>
          <h3 id='meeting-time-title'>{{contactPage.meeting.selectTime}}</h3>
          <p class='meeting-picker__date' data-meeting-selected-date></p>
          <div class='meeting-times' data-meeting-times role='group' aria-labelledby='meeting-time-title'></div>
        </section>
        <p class='meeting-dialog__selection' data-meeting-selection aria-live='polite' hidden></p>
        <form class='meeting-picker contact-form' data-meeting-contact-step aria-labelledby='meeting-contact-title' hidden novalidate>
          <h3 id='meeting-contact-title'>{{contactPage.meeting.contactTitle}}</h3>
          <p class='meeting-picker__date'>{{contactPage.meeting.contactCopy}}</p>
          <div class='contact-form__fields'>
            <label for='meeting-name'><span>{{contactPage.name}}</span><input id='meeting-name' name='name' type='text' autocomplete='name' maxlength='100' required placeholder='{{contactPage.name}} *' /></label>
            <label for='meeting-phone'><span>{{contactPage.phone}}</span><input id='meeting-phone' name='phone' type='tel' autocomplete='tel' inputmode='tel' maxlength='32' required placeholder='{{contactPage.phone}} *' /></label>
          </div>
          <button class='contact-form__submit' type='submit' data-meeting-submit><span>{{contactPage.meeting.submit}}</span><svg aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></button>
          <p class='contact-form__status' data-meeting-status aria-live='polite'></p>
        </form>
      </div>
      </div>
      <section class='meeting-dialog__content form-success' data-meeting-success hidden tabindex='-1' aria-labelledby='meeting-success-title'><h2 id='meeting-success-title'>{{contactPage.meeting.success.title}}</h2><p>{{contactPage.meeting.success.text}}</p><button class='contact-form__submit' type='button' data-meeting-success-close>{{contactPage.meeting.success.close}}</button></section>
    </dialog>
    {{> site-footer}}
    <script id='contact-page-config' type='application/json'>{{{contactPageConfig}}}</script>
    <script type='module' src='/src/main.js'></script>
  </body>
</html>
