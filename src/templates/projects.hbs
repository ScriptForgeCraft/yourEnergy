<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#0d1212' />
    <meta name='color-scheme' content='light' />
    <title>{{meta.title}}</title>
    <meta name='description' content='{{meta.description}}' />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:locale' content='{{localeCode}}' />
    <meta property='og:title' content='{{meta.ogTitle}}' />
    <meta property='og:description' content='{{meta.ogDescription}}' />
    <meta property='og:url' content='https://yourenergy.am{{path}}' />
    <meta property='og:image' content='https://yourenergy.am/images/project-arabkir-1200.jpg' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content='{{meta.ogTitle}}' />
    <meta name='twitter:description' content='{{meta.ogDescription}}' />
    <meta name='twitter:image' content='https://yourenergy.am/images/project-arabkir-1200.jpg' />
    <link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' href='/favicon.png' type='image/png' sizes='512x512' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' sizes='180x180' />
    <link rel='stylesheet' href='/src/styles/projects-index.css' />
  </head>
  <body class='page-projects'>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>
    {{> site-header}}

    <main id='main'>
      <section class='projects-hero' aria-labelledby='projects-hero-title'>
        <div class='projects-hero__media' aria-hidden='true'>
          <picture class='projects-hero__poster'>
            <source type='image/avif' srcset='/images/hero-time-20-1024.avif 1024w, /images/hero-time-20-1600.avif 1600w' sizes='100vw' />
            <source type='image/webp' srcset='/images/hero-time-20-1024.webp 1024w, /images/hero-time-20-1600.webp 1600w' sizes='100vw' />
            <img src='/images/hero-time-20-1600.jpg' width='1600' height='900' alt='' fetchpriority='high' decoding='async' />
          </picture>
          {{#if projectsPage.videoSrc}}<video class='projects-hero__video' data-projects-video muted loop playsinline preload='none'><source src='{{projectsPage.videoSrc}}' type='video/mp4' /></video>{{/if}}
        </div>
        <div class='projects-hero__scrim' aria-hidden='true'></div>

        <div class='container projects-container projects-hero__content'>
          <div class='projects-hero__copy'>
            <h1 id='projects-hero-title'>{{projectsPage.hero.titleLead}}<br /><mark>{{projectsPage.hero.titleAccent}}</mark></h1>
            <p class='projects-hero__intro'>{{projectsPage.hero.copy}}</p>
            <div class='projects-hero__actions'>
              <a class='projects-primary-button' href='#projects-catalog'>{{projectsPage.hero.action}} <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#chevron-down'></use></svg></a>
              <div class='projects-hero__count' aria-label='{{projectsPage.projectCount}} {{projectsPage.hero.countLabel}}'>
                <strong>{{projectsPage.projectCount}}</strong>
                <span>{{projectsPage.hero.countLabel}}</span>
              </div>
            </div>
          </div>

          {{#if projectsPage.videoSrc}}
            <button class='projects-video-button' type='button' data-projects-video-toggle data-projects-video-watch='{{projectsPage.hero.watch}}' data-projects-video-pause='{{projectsPage.hero.pause}}' aria-pressed='false'>
              <span class='projects-video-button__icon' aria-hidden='true'>▶</span>
              <span><strong data-projects-video-label>{{projectsPage.hero.watch}}</strong><small>{{projectsPage.hero.duration}}</small></span>
            </button>
          {{else}}
            <div class='projects-video-button projects-video-button--placeholder' aria-hidden='true'>
              <span class='projects-video-button__icon'>▶</span>
              <span><strong>{{projectsPage.hero.watch}}</strong><small>{{projectsPage.hero.duration}}</small></span>
            </div>
          {{/if}}
        </div>
      </section>

      <section class='projects-featured' aria-labelledby='featured-project-title'>
        <div class='container projects-container'>
          <article class='projects-featured__card'>
            <div class='projects-featured__media'>
              <picture>
                <source type='image/avif' srcset='{{projectsPage.featured.avifSrcset}}' sizes='(max-width: 820px) calc(100vw - 32px), (max-width: 1332px) 55vw, 704px' />
                <source type='image/webp' srcset='{{projectsPage.featured.webpSrcset}}' sizes='(max-width: 820px) calc(100vw - 32px), (max-width: 1332px) 55vw, 704px' />
                <img src='/images/{{projectsPage.featured.image}}-800.jpg' width='800' height='533' alt='{{projectsPage.featured.imageAlt}}' loading='lazy' decoding='async' />
              </picture>
              <span class='projects-featured__badge'><b>01</b> / {{projectsPage.featured.kicker}}</span>
              <span class='projects-featured__location'><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#map-pin'></use></svg>{{projectsPage.featured.city}} · {{projectsPage.featured.category}}</span>
            </div>

            <div class='projects-featured__body'>
              <h2 id='featured-project-title'>{{projectsPage.featured.title}}</h2>
              <p class='projects-featured__copy'>{{projectsPage.featured.copy}}</p>
              <dl class='projects-featured__metrics'>
                {{#each projectsPage.featured.metrics}}
                  <div>
                    <dt><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#{{icon}}'></use></svg><span>{{label}}</span></dt>
                    <dd>{{value}}</dd>
                  </div>
                {{/each}}
              </dl>
              <div class='projects-featured__actions'>
                <a class='projects-primary-button' href='{{projectsPage.featured.href}}'>{{projectsPage.featured.action}} <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a>
                <a class='projects-text-link' href='#projects-catalog' aria-label='{{projectsPage.featured.galleryAction}}'>{{projectsPage.featured.galleryAction}} <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class='projects-list' id='projects-catalog' aria-labelledby='all-projects-title'>
        <div class='container projects-container'>
          <h2 id='all-projects-title'>{{projectsPage.list.title}}</h2>

          <div class='projects-toolbar' data-projects-toolbar>
            <div class='projects-filters' role='group' aria-label='{{projectsPage.list.title}}'>
              <button class='projects-filter is-active' type='button' data-project-filter='all' aria-pressed='true'>{{projectsPage.filters.all}}</button>
              {{#each projectsPage.categories}}<button class='projects-filter' type='button' data-project-filter='{{value}}' aria-pressed='false'>{{label}}</button>{{/each}}
            </div>
            <div class='projects-toolbar__controls'>
              <label class='projects-select'>
                <span class='sr-only'>{{projectsPage.filters.allRegions}}</span>
                <select data-project-region>
                  <option value='all'>{{projectsPage.filters.allRegions}}</option>
                  {{#each projectsPage.regions}}<option value='{{value}}'>{{label}}</option>{{/each}}
                </select>
                <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#chevron-down'></use></svg>
              </label>
              <label class='projects-select'>
                <span class='sr-only'>{{projectsPage.filters.sort}}</span>
                <select data-project-sort>
                  <option value='default'>{{projectsPage.filters.defaultSort}}</option>
                  <option value='power'>{{projectsPage.filters.powerSort}}</option>
                  <option value='production'>{{projectsPage.filters.productionSort}}</option>
                </select>
                <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#chevron-down'></use></svg>
              </label>
            </div>
          </div>

          <div class='projects-card-grid' data-projects-grid>
            {{#each projectsPage.items}}
              <article class='projects-card' data-project-card data-category='{{categoryKey}}' data-region='{{regionKey}}' data-power='{{powerKwp}}' data-production='{{annualProductionKwh}}' data-lat='{{coordinates.lat}}' data-lng='{{coordinates.lng}}'>
                <a class='projects-card__link' href='{{href}}' aria-label='{{action}}: {{title}}'>
                  <picture class='projects-card__media'>
                    <source type='image/avif' srcset='{{avifSrcset}}' sizes='(max-width: 700px) calc(100vw - 32px), (max-width: 1020px) calc((100vw - 60px) / 2), 421px' />
                    <source type='image/webp' srcset='{{webpSrcset}}' sizes='(max-width: 700px) calc(100vw - 32px), (max-width: 1020px) calc((100vw - 60px) / 2), 421px' />
                    <img src='/images/{{image}}-800.jpg' width='800' height='533' alt='{{imageAlt}}' loading='lazy' decoding='async' />
                  </picture>
                  <span class='projects-card__shade' aria-hidden='true'></span>
                  <span class='projects-card__tag'>{{category}}</span>
                  <span class='projects-card__content'>
                    <span class='projects-card__title'>{{title}}</span>
                    <span class='projects-card__city'>{{city}}</span>
                    <span class='projects-card__metrics'>
                      {{#each metrics}}{{#unless @last}}<span><svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#{{icon}}'></use></svg><b>{{value}}</b></span>{{/unless}}{{/each}}
                    </span>
                  </span>
                  <svg class='projects-card__arrow inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg>
                </a>
              </article>
            {{/each}}
          </div>
          <p class='projects-empty' data-projects-empty hidden>{{projectsPage.list.empty}}</p>
          <nav class='projects-pagination' data-projects-pagination data-status-template='{{projectsPage.list.pageStatus}}' aria-label='{{projectsPage.list.paginationLabel}}' hidden>
            <button class='projects-pagination__button' type='button' data-projects-page-previous>
              <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg>
              <span>{{projectsPage.list.previousPage}}</span>
            </button>
            <p class='projects-pagination__status' data-projects-page-status aria-live='polite'></p>
            <button class='projects-pagination__button' type='button' data-projects-page-next>
              <span>{{projectsPage.list.nextPage}}</span>
              <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg>
            </button>
          </nav>
        </div>
      </section>

      <section class='projects-coverage' aria-labelledby='projects-coverage-title'>
        <div class='projects-coverage__media' aria-hidden='true'>
          <picture>
            <source type='image/avif' srcset='/images/hero-time-18-1024.avif 1024w, /images/hero-time-18-1600.avif 1600w' sizes='100vw' />
            <source type='image/webp' srcset='/images/hero-time-18-1024.webp 1024w, /images/hero-time-18-1600.webp 1600w' sizes='100vw' />
            <img src='/images/hero-time-18-1600.jpg' width='1600' height='900' alt='' loading='lazy' decoding='async' />
          </picture>
        </div>
        <div class='projects-coverage__shade' aria-hidden='true'></div>
        <div class='container projects-container projects-coverage__content'>
          <div class='projects-map' aria-hidden='true'>
            <img
              class='projects-map__shape'
              src='{{projectsPage.mapConfig.svgPath}}'
              width='{{projectsPage.mapConfig.svgWidth}}'
              height='{{projectsPage.mapConfig.svgHeight}}'
              alt=''
              loading='lazy'
              decoding='async'
            />
            {{#each projectsPage.coverage.markers}}
              <span class='projects-map__marker' style='--marker-x: {{x}}%; --marker-y: {{y}}%;'>
                <i></i>
              </span>
            {{/each}}
          </div>

          <div class='projects-coverage__copy'>
            <h2 id='projects-coverage-title'>{{projectsPage.coverage.title}}</h2>
            <p>{{projectsPage.coverage.copy}}</p>
            <dl class='projects-coverage__stats'>
              {{#each projectsPage.coverage.stats}}<div><dd>{{value}}</dd><dt>{{label}}</dt></div>{{/each}}
            </dl>
          </div>
        </div>
      </section>

      <section class='projects-process' aria-labelledby='projects-process-title'>
        <div class='container projects-container projects-process__layout'>
          <h2 id='projects-process-title'>{{projectsPage.process.title}}</h2>
          <ol class='projects-process__steps'>
            {{#each projectsPage.process.steps}}
              <li>
                <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#{{icon}}'></use></svg>
                <span><b>{{number}}</b><strong>{{title}}</strong></span>
              </li>
            {{/each}}
          </ol>
        </div>
      </section>

      <section class='projects-cta'>
        <div class='projects-cta__media' aria-hidden='true'>
          <picture>
            <source type='image/avif' srcset='/images/hero-time-20-1024.avif 1024w, /images/hero-time-20-1600.avif 1600w' sizes='100vw' />
            <source type='image/webp' srcset='/images/hero-time-20-1024.webp 1024w, /images/hero-time-20-1600.webp 1600w' sizes='100vw' />
            <img src='/images/hero-time-20-1600.jpg' width='1600' height='900' alt='' loading='lazy' decoding='async' />
          </picture>
        </div>
        <div class='projects-cta__shade' aria-hidden='true'></div>
        <div class='container projects-container projects-cta__content'>
          <div>
            <p class='projects-eyebrow'>{{projectsPage.cta.eyebrow}}</p>
            <h2>{{projectsPage.cta.title}}</h2>
            <p class='projects-cta__copy'>{{projectsPage.cta.copy}}</p>
          </div>
          <div class='projects-cta__actions'>
            <a class='projects-primary-button' href='{{calculatorHref}}'>{{projectsPage.cta.primary}} <svg class='inline-icon' aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></a>
            <a class='projects-secondary-button' href='{{projectsPage.contactHref}}'>{{projectsPage.cta.secondary}}</a>
          </div>
        </div>
      </section>
    </main>

    {{> site-footer}}
    <script id='projects-map-data' type='application/json'>{{{projectsPage.mapDataJson}}}</script>
    <script type='module' src='/src/ui/projects-page.js'></script>
    <script type='module' src='/src/main.js'></script>
  </body>
</html>
