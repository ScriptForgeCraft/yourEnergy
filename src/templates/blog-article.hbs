<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#071a2d' />
    <meta name='description' content='{{article.description}}' />
    <title>{{article.seoTitle}}</title>
    <link rel='canonical' href='https://yourenergy.am{{article.path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' href='/yourenergy-mark.svg' type='image/svg+xml' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />
    <link rel='stylesheet' href='/src/styles/blog.css' />
    <script type='application/ld+json'>{{{articleJsonLd}}}</script>
  </head>
  <body class='blog-page blog-article-page' data-blog-article>
    <a class='skip-link' href='#article-main'>{{aria.skip}}</a>
    {{> site-header}}
    <main id='article-main'>
      <article>
        <header class='article-hero'>
          <img src='{{article.image}}' alt='' aria-hidden='true' />
          <div class='container article-hero__content' data-blog-reveal>
            <a class='article-back-link' href='{{blogHref}}'>← {{blogCopy.backToJournal}}</a>
            <h1>{{article.h1}}</h1>
            <p class='article-hero__intro'>{{article.description}}</p>
            <div class='article-meta article-meta--light'><span>{{blogCopy.verified}} {{article.verifiedDate}}</span><span>{{article.readingTimeLabel}}</span></div>
          </div>
        </header>

        <div class='container article-layout'>
          <aside class='article-toc' aria-label='{{blogCopy.contents}}'>
            <p>{{blogCopy.contents}}</p>
            <ol>{{#each article.toc}}<li><a href='#{{id}}'>{{heading}}</a></li>{{/each}}</ol>
          </aside>
          <div class='article-prose' data-blog-reveal>
            <div class='article-editorial-note'><span aria-hidden='true'>✦</span><p>{{blogCopy.editorialNote}}</p></div>
            {{#each article.blocks}}
              {{#if heading}}<h2 id='{{id}}'>{{heading}}</h2>{{else}}<p class='{{#if lead}}article-lead{{/if}} {{#if callout}}article-callout{{/if}}'>{{paragraph}}</p>{{/if}}
            {{/each}}
            <div class='article-inline-cta'><p>{{article.cta}}</p><a href='{{calculatorHref}}'>{{blogCopy.calculate}} <span aria-hidden='true'>→</span></a></div>
            <section class='article-sources' aria-labelledby='sources-title'><h2 id='sources-title'>{{blogCopy.sources}}</h2><ol>{{#each article.sources}}<li><a href='{{this}}' target='_blank' rel='noopener noreferrer'>{{this}}</a></li>{{/each}}</ol></section>
          </div>
        </div>
      </article>

      <section class='related-section container' aria-labelledby='related-title'>
        <div class='blog-section-heading'><div><h2 id='related-title'>{{blogCopy.related}}</h2></div><a class='article-arrow-link' href='{{blogHref}}'>{{blogCopy.backToJournal}} <span aria-hidden='true'>→</span></a></div>
        <div class='related-grid'>{{#each relatedArticles}}<article class='blog-card' data-blog-reveal><a class='blog-card__image' href='{{path}}' tabindex='-1' aria-hidden='true'><img src='{{image}}' alt='' loading='lazy' /></a><div class='blog-card__content'><h3><a href='{{path}}'>{{h1}}</a></h3><div class='blog-card__bottom'><span>{{../blogCopy.verified}} {{verifiedDate}}</span><a href='{{path}}' aria-label='{{../blogCopy.readArticle}}: {{h1}}'>→</a></div></div></article>{{/each}}</div>
      </section>
    </main>
    {{> site-footer}}
    <script type='module' src='/src/main.js'></script>
  </body>
</html>
