<footer class='site-footer' id='contacts'><div class='container footer-grid'><div><a
        class='wordmark'
        href='{{homeHref}}'
      ><span>YOUR</span><strong>ENERGY</strong></a><p>{{footer.description}}</p></div>{{#each
      footer.columns
    }}<div><h2>{{title}}</h2><ul role='list'>{{#each links}}<li><a
                href='{{this.[1]}}'
              >{{this.[0]}}</a></li>{{/each}}</ul></div>{{/each}}<div class='footer-contact'><h2
      >{{footer.contacts}}</h2><p><svg class='inline-icon' aria-hidden='true'><use
            href='/icons.svg#phone'
          ></use></svg><a href='{{contact.phoneHref}}'>{{contact.phone}}</a></p><p><svg
          class='inline-icon'
          aria-hidden='true'
        ><use href='/icons.svg#whatsapp'></use></svg><a
          href='{{contact.whatsappHref}}'
          target='_blank'
          rel='noopener noreferrer'
        >{{contact.whatsapp}}</a></p><p><svg class='inline-icon' aria-hidden='true'><use
            href='/icons.svg#pin'
          ></use></svg><span class='footer-address'>{{contact.address1}}</span></p><p><svg
          class='inline-icon'
          aria-hidden='true'
        ><use href='/icons.svg#pin'></use></svg><span
          class='footer-address'
        >{{contact.address2}}</span></p><p><svg class='inline-icon' aria-hidden='true'><use
            href='/icons.svg#sun'
          ></use></svg><span>{{contact.hours}}</span></p></div></div><div
    class='container footer-bottom'
  ><span>{{footer.copyright}}</span><span class='footer-legal'><a
        href='{{supportBase}}/privacy/'
      >{{footer.privacy}}</a><span aria-hidden='true'>·</span><a
        href='{{supportBase}}/terms/'
      >{{footer.terms}}</a></span><span
      class='footer-developed-by'
    >{{footer.developedBy}}</span></div></footer><aside
  class='service-worker-update'
  data-service-worker-update
  hidden
  role='status'
  aria-live='polite'
><p>{{footer.update.message}}</p><button
    class='service-worker-update__action'
    type='button'
    data-service-worker-reload
  >{{footer.update.action}}</button></aside><nav
  class='floating-contact-actions'
  aria-label='{{nav.contacts}}'
><a
    class='floating-contact-action floating-contact-action--whatsapp'
    href='{{contact.whatsappHref}}'
    target='_blank'
    rel='noopener noreferrer'
    aria-label='{{contact.whatsappLabel}}'
    data-contact-label='WhatsApp'
  ><svg aria-hidden='true' focusable='false'><use href='/icons.svg#whatsapp'></use></svg></a><a
    class='floating-contact-action floating-contact-action--phone'
    href='{{contact.phoneHref}}'
    aria-label='{{contact.phoneLabel}}'
    data-contact-label='{{contact.phone}}'
  ><svg aria-hidden='true' focusable='false'><use href='/icons.svg#phone'></use></svg></a></nav>