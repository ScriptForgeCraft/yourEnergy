<h2 id='process-title' class='visually-hidden'>{{processStory.title}}</h2>
<div class='process-stage' data-process-stage data-process-active='1'>
  <div class='process-stage__frame'>
    <div class='process-stage__ambient' aria-hidden='true'><span></span><span></span><span
      ></span></div>

    <nav class='process-progress' aria-label='{{processStory.progressLabel}}'>
      <span class='process-progress__track' aria-hidden='true'><i
          data-process-progress-fill
        ></i></span>
      <ol>
        {{#each processStory.steps}}
          <li class='{{progressClass}}' data-process-progress-step='{{index}}'>
            <span class='process-progress__node' aria-hidden='true'><b>{{number}}</b><svg><use
                  href='/icons.svg#check'
                ></use></svg></span>
            <span>{{nav}}</span>
          </li>
        {{/each}}
      </ol>
    </nav>

    <div class='process-stage__states'>
      {{#each processStory.steps}}
        <article
          class='process-state {{stateClass}}'
          data-process-state='{{index}}'
          aria-labelledby='process-step-title-{{number}}'
          aria-hidden='{{ariaHidden}}'
        >
          <div class='process-state__copy' data-process-copy>
            <p class='process-state__eyebrow'><span aria-hidden='true'></span>{{stepLabel}}</p>
            <h3 id='process-step-title-{{number}}' class='process-state__title'>
              {{#each headlineLines}}<span>{{this}}</span>{{/each}}
            </h3>
            <p class='process-state__intro'>{{copy}}</p>

            {{#if isAnalysis}}
              <form
                class='process-form'
                data-process-form
                action='{{@root.calculatorHref}}'
                method='get'
              >
                <label
                  class='visually-hidden'
                  for='process-region'
                >{{@root.processStory.form.region}}</label>
                <div class='process-form__select'>
                  <svg class='inline-icon' aria-hidden='true'><use
                      href='/icons.svg#map-pin'
                    ></use></svg>
                  <select id='process-region' name='region' required data-process-region>
                    <option value=''>{{@root.processStory.form.chooseRegion}}</option>
                    {{#each @root.processStory.regions}}<option
                        value='{{id}}'
                      >{{label}}</option>{{/each}}
                  </select>
                </div>
                <fieldset class='process-form__modes' data-process-consumption>
                  <legend class='visually-hidden'>{{@root.processStory.form.consumption}}</legend>
                  <label><input type='radio' name='mode' value='bill' checked /><span
                    >{{@root.processStory.form.bill}}</span></label>
                  <label><input type='radio' name='mode' value='usage' /><span
                    >{{@root.processStory.form.usage}}</span></label>
                </fieldset>
                <label
                  class='process-form__amount-label'
                  for='process-amount'
                  data-process-amount-label
                  data-process-consumption
                >{{@root.processStory.form.amountBill}}</label>
                <div class='process-form__amount' data-process-consumption>
                  <input
                    id='process-amount'
                    name='amount'
                    type='number'
                    inputmode='decimal'
                    min='0.01'
                    step='any'
                    required
                    aria-describedby='process-input-help'
                    data-process-amount
                  />
                  <span data-process-unit>AMD</span>
                </div>
                <p
                  class='process-form__help'
                  id='process-input-help'
                  data-process-help
                  data-process-consumption
                >{{@root.processStory.form.billHelp}}</p>
                <button type='submit' class='process-form__submit'>
                  <span data-process-submit-label>{{@root.processStory.form.submit}}</span>
                  <svg class='inline-icon' aria-hidden='true'><use
                      href='/icons.svg#arrow-right'
                    ></use></svg>
                </button>
                <a
                  class='process-form__full'
                  href='{{@root.calculatorHref}}'
                >{{@root.processStory.form.full}} <span aria-hidden='true'>↗</span></a>
              </form>
            {{/if}}

            {{#if isSupport}}
              <a class='process-state__cta' href='{{@root.calculatorHref}}'>{{cta}}
                <svg class='inline-icon' aria-hidden='true'><use
                    href='/icons.svg#arrow-right'
                  ></use></svg>
              </a>
            {{/if}}
          </div>

          <div
            class='process-visual process-visual--{{visual}}'
            data-process-visual='{{visual}}'
            role='img'
            aria-label='{{visualLabel}}'
          >
            <div class='process-visual__depth' aria-hidden='true'>
              <span class='process-visual__halo'></span>

              {{#if isAnalysis}}
                <svg class='process-visual__solar-arc' viewBox='0 0 700 470' data-process-solar-arc>
                  <path d='M76 354 Q350 -120 624 354' data-process-solar-path></path>
                  <path class='process-visual__horizon' d='M76 354H624'></path>
                  <text x='55' y='383'>W</text><text x='342' y='70'>N</text><text
                    x='632'
                    y='383'
                  >E</text>
                  <g data-process-sun transform='translate(350 105)'>
                    <circle class='process-visual__sun-halo' r='31'></circle>
                    <circle class='process-visual__sun-core' r='13'></circle>
                    <path
                      d='M0-25v-9M0 25v9M25 0h9M-25 0h-9M18-18l7-7M-18 18l-7 7M18 18l7 7M-18-18l-7-7'
                    ></path>
                  </g>
                </svg>
                <div class='process-house'><span class='process-house__roof'></span><span
                    class='process-house__wall'
                  ></span><span class='process-house__window'></span><span
                    class='process-house__panel'
                  ></span></div>
                <span class='process-visual__terrain process-visual__terrain--one'></span><span
                  class='process-visual__terrain process-visual__terrain--two'
                ></span>
              {{/if}}

              {{#if isInspection}}
                <div class='process-roof'>
                  <span class='process-roof__plane'></span><span
                    class='process-roof__ridge'
                  ></span><span class='process-roof__scan'></span>
                  <i style='--point-x:16%;--point-y:72%'></i><i
                    style='--point-x:36%;--point-y:18%'
                  ></i><i style='--point-x:84%;--point-y:30%'></i><i
                    style='--point-x:70%;--point-y:86%'
                  ></i>
                </div>
                <svg class='process-measure' viewBox='0 0 640 400'><path
                    d='M103 297 230 78 537 122 449 344Z'
                  ></path><path
                    class='process-measure__dash'
                    d='M93 318H459M559 112v246'
                  ></path><text x='238' y='342'>m²</text><text x='570' y='240'>°</text></svg>
              {{/if}}

              {{#if isDesign}}
                <div class='process-system'>
                  <div class='process-system__panels'>{{#each designPanels}}<span
                        style='--panel-i:{{this}}'
                      ></span>{{/each}}</div>
                  <div class='process-system__inverter'><svg class='inline-icon'><use
                        href='/icons.svg#zap'
                      ></use></svg><i></i><i></i><i></i></div>
                  <svg class='process-system__flow' viewBox='0 0 640 420'><path
                      d='M108 279C253 363 370 345 507 228'
                    ></path><circle cx='108' cy='279' r='5'></circle><circle
                      cx='507'
                      cy='228'
                      r='5'
                    ></circle></svg>
                </div>
              {{/if}}

              {{#if isProposal}}
                <div class='process-proposal'>
                  <div class='process-proposal__sheet'><span
                      class='process-proposal__brand'
                    >YOURENERGY</span><strong>{{nav}}</strong><i></i><i></i><i></i><i></i><span
                      class='process-proposal__seal'
                    ><svg class='inline-icon'><use href='/icons.svg#check'></use></svg></span></div>
                  <span class='process-proposal__card process-proposal__card--one'></span><span
                    class='process-proposal__card process-proposal__card--two'
                  ></span>
                </div>
              {{/if}}

              {{#if isInstallation}}
                <div class='process-install'><div class='process-install__system'>{{#each
                      installPanels
                    }}<span style='--install-i:{{this}}'></span>{{/each}}</div><span
                    class='process-install__pulse'
                  ></span></div>
              {{/if}}

              {{#if isSupport}}
                <div class='process-passport'>
                  <span class='process-passport__back'></span>
                  <div class='process-passport__cover'><svg class='inline-icon'><use
                        href='/icons.svg#sun'
                      ></use></svg><small>YOURENERGY</small><strong>Solar<br />Passport</strong><i
                    ></i></div>
                  <div class='process-passport__page'><span></span><span></span><span></span><svg
                      class='inline-icon'
                    ><use href='/icons.svg#shield-check'></use></svg></div>
                </div>
              {{/if}}
            </div>

            {{#if cards}}
              <ul class='process-metrics' role='list'>
                {{#each cards}}
                  <li class='process-metric' data-process-card>
                    <svg class='inline-icon' aria-hidden='true'><use
                        href='/icons.svg#{{icon}}'
                      ></use></svg>
                    <span>{{label}}</span>
                    <strong
                      data-process-value='{{data}}'
                      data-default='{{value}}'
                    >{{value}}</strong>
                    <small data-process-value-note='{{data}}'></small>
                  </li>
                {{/each}}
              </ul>
            {{/if}}

            {{#if timeline}}
              <ol class='process-installation-timeline'>{{#each timeline}}<li
                    data-process-install-step
                  ><b>{{number}}</b><span>{{label}}</span></li>{{/each}}</ol>
            {{/if}}
          </div>
        </article>
      {{/each}}
    </div>

    <p class='process-stage__scroll-hint' aria-hidden='true'><span
      ></span>{{processStory.scrollLabel}}</p>
  </div>
</div>