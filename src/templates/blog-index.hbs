<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#071a2d' />
    <meta name='color-scheme' content='light' />
    <meta name='description' content='{{blogMeta.description}}' />
    <title>{{blogMeta.title}}</title>
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:locale' content='{{localeCode}}' />
    <meta property='og:title' content='{{blogMeta.title}}' />
    <meta property='og:description' content='{{blogMeta.description}}' />
    <meta property='og:url' content='https://yourenergy.am{{path}}' />
    <meta property='og:image' content='https://yourenergy.am{{blogMeta.image}}' />
    <meta property='og:image:width' content='1600' />
    <meta property='og:image:height' content='900' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content='{{blogMeta.title}}' />
    <meta name='twitter:description' content='{{blogMeta.description}}' />
    <meta name='twitter:image' content='https://yourenergy.am{{blogMeta.image}}' />
    <link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' href='/favicon.png' type='image/png' sizes='512x512' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' sizes='180x180' />
    <link rel='stylesheet' href='/src/styles/blog.css' />
  </head>
  <body class='blog-page' data-blog-page>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>
    {{> site-header}}
    <main id='main'>
      <section class='blog-hero' aria-labelledby='blog-title'>
        <picture><source media='(min-width: 1024px)' type='image/avif' srcset='/images/blog-hero-1024.avif 1024w, /images/blog-hero-1600.avif 1600w' sizes='100vw' /><source media='(min-width: 1024px)' type='image/webp' srcset='/images/blog-hero-1024.webp 1024w, /images/blog-hero-1600.webp 1600w' sizes='100vw' /><source media='(min-width: 1024px)' type='image/jpeg' srcset='/images/blog-hero-1024.jpg 1024w, /images/blog-hero-1600.jpg 1600w' sizes='100vw' /><source type='image/avif' srcset='/images/hero-time-8-640.avif 640w, /images/hero-time-8-1024.avif 1024w, /images/hero-time-8-1600.avif 1600w' sizes='100vw' /><source type='image/webp' srcset='/images/hero-time-8-640.webp 640w, /images/hero-time-8-1024.webp 1024w, /images/hero-time-8-1600.webp 1600w' sizes='100vw' /><img src='/images/hero-time-8-1600.webp' width='1600' height='900' alt='' aria-hidden='true' fetchpriority='high' decoding='async' /></picture>
        <div class='container blog-hero__content' data-blog-reveal>
          <h1 id='blog-title'>{{blogCopy.heroBefore}} <span>{{blogCopy.heroAccent}}</span></h1>
          <p>{{blogCopy.heroText}}</p>
        </div>
      </section>

      <section class='blog-catalog container' aria-label='{{blogCopy.allArticles}}'>
        <div class='blog-categories' role='toolbar' aria-label='{{blogCopy.allArticles}}'>
          <button class='blog-category is-active' type='button' aria-pressed='true' data-blog-filter='all'>{{blogCopy.allArticles}}</button>
          {{#each categories}}<button class='blog-category' type='button' aria-pressed='false' data-blog-filter='{{key}}'>{{label}}</button>{{/each}}
        </div>

        <article class='featured-article' data-blog-reveal>
          <a class='featured-article__image' href='{{featured.path}}' tabindex='-1' aria-hidden='true'><picture><source type='image/avif' srcset='{{featured.imageAvifSrcset}}' sizes='(max-width: 760px) 100vw, 52vw' /><source type='image/webp' srcset='{{featured.imageWebpSrcset}}' sizes='(max-width: 760px) 100vw, 52vw' /><img src='{{featured.image}}' width='{{featured.imageWidth}}' height='{{featured.imageHeight}}' alt='' decoding='async' /></picture></a>
          <div class='featured-article__content'>
            <h2><a href='{{featured.path}}'>{{featured.h1}}</a></h2>
            <p class='featured-article__description'>{{featured.description}}</p>
            <div class='article-meta'><span>{{blogCopy.verified}} {{featured.verifiedDate}}</span><span>{{featured.readingTimeLabel}}</span></div>
            <a class='article-arrow-link' href='{{featured.path}}'>{{blogCopy.readArticle}} <span aria-hidden='true'>→</span></a>
          </div>
        </article>

        <div class='blog-section-heading'>
          <div><h2>{{blogCopy.latest}}</h2></div>
          <div class='blog-section-heading__controls'>
            <label class='blog-search' for='blog-search'>
              <span class='visually-hidden'>{{blogCopy.searchLabel}}</span>
              <svg aria-hidden='true' viewBox='0 0 24 24'><circle cx='10.8' cy='10.8' r='6.5'></circle><path d='m16 16 4.2 4.2'></path></svg>
              <input id='blog-search' type='search' autocomplete='off' placeholder='{{blogCopy.searchPlaceholder}}' data-blog-search />
              <span aria-hidden='true'>→</span>
            </label>
            <div class='blog-view-toggle' role='group' aria-label='{{blogCopy.latest}}'>
              <button class='is-active' type='button' aria-pressed='true' data-blog-view='grid'>{{blogCopy.grid}}</button>
              <button type='button' aria-pressed='false' data-blog-view='list'>{{blogCopy.list}}</button>
            </div>
          </div>
        </div>

        <div class='blog-content-layout'>
          <div class='blog-article-grid' data-blog-grid>
            {{#each articles}}<article class='blog-card' data-blog-card data-category='{{categoryKey}}' data-search='{{searchText}}' data-search-aliases='{{searchAliases}}' data-blog-reveal>
              <a class='blog-card__image' href='{{path}}' tabindex='-1' aria-hidden='true'><picture><source type='image/avif' srcset='{{imageAvifSrcset}}' sizes='(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw' /><source type='image/webp' srcset='{{imageWebpSrcset}}' sizes='(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw' /><img src='{{image}}' width='{{imageWidth}}' height='{{imageHeight}}' alt='' loading='lazy' decoding='async' /></picture></a>
              <div class='blog-card__content'><h3><a href='{{path}}'>{{h1}}</a></h3><p class='blog-card__summary'>{{description}}</p><div class='blog-card__bottom'><span>{{blogCopy.verified}} {{verifiedDate}}</span><span>{{readingTimeLabel}}</span><a href='{{path}}' aria-label='{{blogCopy.readArticle}}: {{h1}}'>→</a></div></div>
            </article>{{/each}}
            <p class='blog-no-results' hidden data-blog-no-results>{{blogCopy.noResults}}</p>
          </div>

          <aside class='blog-sidebar' aria-label='{{blogCopy.popular}}' data-blog-reveal>
            <section class='popular-articles'><h2>{{blogCopy.popular}}</h2><ol>{{#each articles}}<li><a href='{{path}}'><span>{{number}}</span><span>{{h1}}</span></a></li>{{/each}}</ol></section>
            <section class='blog-side-cta'><p>{{blogCopy.ctaTitle}}</p><span>{{blogCopy.ctaText}}</span><a href='{{calculatorHref}}'>{{blogCopy.calculate}} <span aria-hidden='true'>→</span></a></section>
          </aside>
        </div>
      </section>
    </main>
    {{> site-footer}}
    <script type='module' src='/src/main.js'></script>
  </body>
</html>
