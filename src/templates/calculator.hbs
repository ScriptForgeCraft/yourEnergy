<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' /><meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#071a2d' /><meta name='robots' content='noindex,follow' /><title>{{meta.title}}</title>
    <meta name='description' content='{{meta.description}}' /><meta property='og:type' content='website' /><meta property='og:site_name' content='YOURENERGY' />
    <meta property='og:title' content='{{meta.ogTitle}}' /><meta property='og:description' content='{{meta.ogDescription}}' /><meta property='og:url' content='https://yourenergy.am{{path}}' /><meta property='og:image' content='https://yourenergy.am/og.png' />
    <meta name='twitter:card' content='summary_large_image' /><link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' /><link rel='icon' href='/yourenergy-mark.svg' type='image/svg+xml' /><link rel='apple-touch-icon' href='/apple-touch-icon.png' /><link rel='stylesheet' href='/src/styles/tools-page.css' />
    <script type='application/ld+json'>{{{jsonLd}}}</script>
  </head>
  <body class='calculator-page calculator-page--wizard calculator-page--professional'>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>{{> site-header}}
    <main id='main'><div data-calculator-wizard data-professional-calculator aria-labelledby='calculator-title'>
      <noscript><style>[data-wizard-step][hidden]{display:block!important}.wizard-progress,.wizard-mobile-progress{display:none!important}</style><section class='section section--soft'><div class='container'><h2>{{toolShared.calculator}}</h2><p>{{product.common.noJsCalculator}}</p><a class='button' href='{{contact.phoneHref}}'>{{contact.phone}}</a></div></section></noscript>
      <section class='calculator-hero calculator-hero--professional section'><div class='container calculator-hero__inner professional-hero__inner'><div class='professional-hero__copy'><nav class='calculator-breadcrumb' aria-label='Breadcrumb'><a href='{{calculatorHref}}'>{{toolShared.calculator}}</a><svg aria-hidden='true'><use href='/icons.svg#chevron-right'></use></svg><span>{{modeControl.professional}}</span></nav><h1 id='calculator-title'>{{wizard.title}}</h1><p>{{wizard.intro}}</p></div><div class='professional-hero__controls'><nav class='wizard-progress' aria-label='{{toolShared.calculator}}'>{{#each wizard.steps}}<button type='button' data-wizard-nav='{{@index}}' data-step-state='{{#if @first}}available{{else}}locked{{/if}}' aria-label='{{this}}'><span>{{add @index 1}}</span><strong>{{this}}</strong></button>{{/each}}</nav><a class='professional-quick-switch' data-calculator-mode='quick' href='{{calculatorHref}}'><svg aria-hidden='true'><use href='/icons.svg#zap'></use></svg><span><strong>{{modeControl.quick}}</strong><small>{{modeControl.quickCopy}}</small></span></a></div></div></section>
      <section class='wizard section'><div class='container wizard__container'>
        <p class='wizard-mobile-progress' data-wizard-mobile-progress aria-live='polite'></p><p class='wizard-status form-status' data-wizard-status aria-live='polite'></p>

        <section class='wizard-step' data-wizard-step='0' aria-labelledby='wizard-object-title' tabindex='-1'>
          <div class='wizard-step__heading'><span>1</span><div><h2 id='wizard-object-title'>{{wizard.locationTitle}}</h2><p>{{wizard.locationCopy}}</p></div></div>
          <div class='professional-location-form'><div class='location-methods'><button class='button button--outline is-selected' type='button' data-open-location-map><svg aria-hidden='true'><use href='/icons.svg#search'></use></svg>{{wizard.mapOpen}}</button><button class='button button--outline' type='button' data-use-current-location><svg aria-hidden='true'><use href='/icons.svg#map-pin'></use></svg>{{product.location.manualTitle}}</button></div><label class='location-address-field' for='wizard-address'><span class='visually-hidden'>{{wizard.addressLabel}}</span><svg aria-hidden='true'><use href='/icons.svg#search'></use></svg><input id='wizard-address' data-wizard-address maxlength='220' autocomplete='street-address' placeholder='{{hero.addressPlaceholder}}' /><svg class='location-address-field__clear' aria-hidden='true'><use href='/icons.svg#close'></use></svg></label><div class='location-selects'><label>{{toolShared.calculator}}<select data-location-region><option>Yerevan</option></select></label><label>{{product.location.title}}<select data-location-city><option>Yerevan</option></select></label><label>{{product.common.optional}}<select data-location-district><option>{{product.common.optional}}</option></select></label></div><section class='professional-panel professional-panel--coordinates' aria-labelledby='professional-location-parameters'><div class='professional-panel__title'><h3 id='professional-location-parameters'>{{wizard.engineering}}</h3><button class='text-button' type='button' data-use-map-coordinates><svg aria-hidden='true'><use href='/icons.svg#map-pin'></use></svg>{{wizard.mapOpen}}</button></div><div class='wizard-coordinates'><label>{{product.location.latitudeLabel}}<input type='number' step='any' inputmode='decimal' value='40.1811' data-location-latitude /></label><label>{{product.location.longitudeLabel}}<input type='number' step='any' inputmode='decimal' value='44.5136' data-location-longitude /></label></div></section><div class='point-confirmation' data-point-confirmation hidden><strong>{{wizard.selectedPoint}}</strong><output data-pending-coordinates>—</output><div><button type='button' class='button' data-confirm-location>{{wizard.confirmPoint}}</button></div></div><div class='professional-location-notice'><svg aria-hidden='true'><use href='/icons.svg#shield-check'></use></svg><p>{{wizard.potentialReady}}</p></div><div class='async-card' data-potential-loading data-potential-status data-step-state='locked' aria-live='polite'></div><div data-potential-result hidden><dl class='wizard-kpis'><div><dt>{{product.potential.annualYieldLabel}}</dt><dd data-potential-yield>—</dd></div><div><dt>{{product.potential.orientationLabel}}</dt><dd data-potential-azimuth>—</dd></div><div><dt>{{product.potential.tiltLabel}}</dt><dd data-potential-tilt>—</dd></div></dl><figure class='wizard-chart'><figcaption>{{product.potential.annualYieldLabel}} · kWh/kWp</figcaption><div class='chart-bars' data-potential-chart></div><details><summary>{{passport.tableTitle}}</summary><table><thead><tr><th>{{passport.monthLabel}}</th><th>kWh/kWp</th></tr></thead><tbody data-potential-table></tbody></table></details></figure><p class='input-help' data-potential-source></p><p class='section-disclosure'>{{product.potential.disclosure}}</p></div><div class='flow-actions' data-potential-actions><button class='button button--outline' type='button' data-potential-retry hidden>{{product.potential.retry}}</button><button class='button button--outline' type='button' data-potential-skip hidden>{{wizard.potentialSkip}}</button></div><div class='flow-actions professional-location-actions'><button class='button button--outline' type='button' data-wizard-back='0'><svg aria-hidden='true'><use href='/icons.svg#arrow-left'></use></svg>{{wizard.back}}</button><button class='button' type='button' data-location-continue>{{wizard.next}}: {{product.consumption.title}}<svg aria-hidden='true'><use href='/icons.svg#arrow-right'></use></svg></button></div></div>
          <div class='wizard-map-wrap wizard-map-wrap--location' data-location-map-wrap><div class='property-map wizard-map' data-property-map data-mode='location'></div><div class='wizard-map__layers' role='group' aria-label='Map layer'><button class='is-active' type='button' data-map-layer='map'>Map</button><button type='button' data-map-layer='satellite'>Satellite</button></div><button class='wizard-map__search' type='button' data-map-focus-location><svg aria-hidden='true'><use href='/icons.svg#search'></use></svg>{{wizard.mapOpen}}</button><aside class='wizard-map__data'><div class='wizard-map__data-title'>Location data <span>(PVGIS)</span></div><div><span class='map-data-icon map-data-icon--sun'><svg aria-hidden='true'><use href='/icons.svg#sun'></use></svg></span><p><strong>1,702</strong><small>kWh/m²/year<br />Annual irradiation</small></p></div><div><span class='map-data-icon map-data-icon--heat'>♨</span><p><strong>4.7</strong><small>kWh/m²/day<br />Daily average</small></p></div><div><span class='map-data-icon map-data-icon--chart'><svg aria-hidden='true'><use href='/icons.svg#chart-bars'></use></svg></span><p><strong>+15%</strong><small>vs. EU average<br />Higher solar potential</small></p></div></aside><aside class='wizard-map__place'><img src='/images/roof-scan-480.webp' alt='' /><div><strong>Yerevan, Armenia</strong><p>Lat: <output data-map-latitude>40.1811</output><br />Lon: <output data-map-longitude>44.5136</output></p><span><svg aria-hidden='true'><use href='/icons.svg#sun'></use></svg>Annual solar irradiation<br /><b>1,702 kWh/m²/year</b></span></div></aside></div>
        </section>

        <section class='wizard-step' data-wizard-step='1' aria-labelledby='wizard-consumption-title' hidden tabindex='-1'>
          <div class='wizard-step__heading'><span>2</span><div><h2 id='wizard-consumption-title'>{{product.consumption.title}}</h2><p>{{product.consumption.copy}}</p></div></div>
          <div data-consumption-inputs class='consumption-inputs'><fieldset><legend>{{product.consumption.title}}</legend><label><input type='radio' name='consumption-mode' value='bill' checked /> {{product.consumption.modes.bill}}</label><label><input type='radio' name='consumption-mode' value='usage' /> {{product.consumption.modes.usage}}</label><label><input type='radio' name='consumption-mode' value='monthly' /> {{product.consumption.modes.monthly}}</label></fieldset><div class='consumption-panel' data-consumption-panel='bill'><label>{{product.consumption.billLabel}}<div class='input-with-unit'><input type='number' min='0.01' step='1' inputmode='decimal' data-consumption-bill /><span>AMD</span></div></label></div><div class='consumption-panel' data-consumption-panel='usage' hidden><label>{{product.consumption.usageLabel}}<div class='input-with-unit'><input type='number' min='0.01' step='1' inputmode='decimal' data-consumption-usage /><span>kWh</span></div></label></div><div class='consumption-panel consumption-panel--months' data-consumption-panel='monthly' hidden><div class='month-inputs'>{{#each passport.months}}<label>{{short}}<input type='number' min='0' step='1' inputmode='decimal' data-consumption-month /></label>{{/each}}</div></div><label><span data-consumption-tariff-label>{{product.consumption.tariffBillLabel}}</span><div class='input-with-unit'><input type='number' min='0.01' step='0.01' inputmode='decimal' data-consumption-tariff aria-describedby='consumption-tariff-help' required aria-required='true' /><span>AMD/kWh</span></div></label><p class='input-help' id='consumption-tariff-help' data-consumption-tariff-help>{{product.consumption.tariffBillHelp}}</p><p>{{product.consumption.annualLabel}}: <output data-consumption-annual>—</output> kWh</p></div>
          <section class='professional-panel file-upload' data-optional-upload aria-labelledby='professional-file-title'><h3 id='professional-file-title'>{{hero.uploadTitle}}</h3><p>{{hero.uploadHelp}}</p><label class='file-drop' data-file-drop for='bill-file'><input id='bill-file' type='file' accept='.pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png' /><span>{{hero.uploadPrompt}}</span></label><p class='form-status' data-file-status aria-live='polite'></p><div data-file-meta hidden><strong data-file-name></strong><button type='button' class='button button--outline' data-file-remove>{{product.common.cancel}}</button></div></section>
          <div class='flow-actions'><button class='button button--outline' type='button' data-wizard-back='0'>{{wizard.back}}</button><button class='button' type='button' data-consumption-continue>{{wizard.next}}</button></div>
        </section>

        <section class='wizard-step' data-wizard-step='2' aria-labelledby='wizard-roof-title' hidden tabindex='-1'>
          <div class='wizard-step__heading'><span>3</span><div><h2 id='wizard-roof-title'>{{product.roof.title}}</h2><p>{{wizard.roofIntro}}</p></div></div>
          <div class='wizard-map-wrap'><div data-roof-map-host></div></div><p class='input-help'>{{wizard.mapApproximate}}</p><p class='input-help'>{{wizard.drawRoof}}</p><div class='roof-controls'><button class='button button--outline' type='button' data-roof-add-center>{{product.roof.addPointAtCenter}}</button><button class='button button--outline' type='button' data-roof-undo>{{product.roof.undo}}</button><button class='button button--outline' type='button' data-roof-reset>{{product.roof.reset}}</button><button class='button' type='button' data-roof-finish>{{product.roof.finish}}</button></div><p class='roof-area-readout'><span data-roof-points>{{product.roof.pointsLabel}}</span><span data-roof-area-label>{{product.roof.areaLabel}}</span><strong data-roof-area>—</strong></p>
          <fieldset><legend>{{product.roof.areaMethodTitle}}</legend><label><input type='radio' name='roof-area-method' value='map-projected' checked data-roof-area-method /> {{product.roof.areaMethods.mapProjected}}</label><label><input type='radio' name='roof-area-method' value='measured-plane' data-roof-area-method /> {{product.roof.areaMethods.measuredPlane}}</label></fieldset><label data-roof-plane-area-wrap hidden>{{product.roof.planeAreaLabel}}<div class='input-with-unit'><input type='number' min='0.01' step='0.1' inputmode='decimal' data-roof-plane-area /><span>m²</span></div></label>
          <section class='professional-panel' aria-labelledby='professional-roof-parameters'><h3 id='professional-roof-parameters'>{{wizard.engineering}}</h3><div class='wizard-form-grid'><label>{{product.roof.orientationLabel}}<select data-roof-orientation><option value='180'>{{product.roof.orientationOptions.south}}</option><option value='135'>{{product.roof.orientationOptions.southEast}}</option><option value='225'>{{product.roof.orientationOptions.southWest}}</option><option value='90'>{{product.roof.orientationOptions.east}}</option><option value='270'>{{product.roof.orientationOptions.west}}</option><option value='0'>{{product.roof.orientationOptions.north}}</option><option value='custom'>{{product.roof.orientationOptions.custom}}</option></select></label><label>{{product.roof.tiltLabel}}<div class='input-with-unit'><input type='number' min='0' max='90' step='1' inputmode='decimal' value='30' data-roof-tilt /><span>°</span></div></label></div><label data-roof-orientation-custom hidden>{{product.roof.customOrientationLabel}}<input type='number' min='0' max='359' step='1' inputmode='decimal' data-roof-orientation-custom-input /></label><fieldset class='mounting-cards'><legend>{{product.roof.mountingModeLabel}}</legend><label><input type='radio' name='mounting-mode' value='roof-parallel' checked data-roof-mounting-mode /><span><strong>{{wizard.parallel}}</strong><small>{{product.roof.mountingModeHelp}}</small></span></label><label><input type='radio' name='mounting-mode' value='elevated' data-roof-mounting-mode /><span><strong>{{wizard.elevated}}</strong><small>{{product.potential.disclosure}}</small></span></label></fieldset></section>
          <div class='flow-actions'><button class='button button--outline' type='button' data-wizard-back='1'>{{wizard.back}}</button><button class='button' type='button' data-run-analysis>{{wizard.calculate}}</button></div>
        </section>

        <section class='wizard-step' data-wizard-step='3' aria-labelledby='wizard-result-title' hidden tabindex='-1'>
          <div class='wizard-step__heading'><span>4</span><div><h2 id='wizard-result-title'>{{product.result.title}}</h2><p data-result-summary></p></div></div><div class='result-dashboard' data-result-dashboard aria-live='polite'></div><section class='finance-empty' data-finance-empty hidden><p>{{wizard.tariffNeeded}}</p><button class='button' type='button' data-add-tariff>{{wizard.addTariff}}</button></section><section data-finance-result hidden><h3>{{finance.title}}</h3><dl data-finance-values></dl><p class='section-disclosure'>{{finance.disclaimer}}</p></section><div class='flow-actions'><button class='button button--outline' type='button' data-wizard-back='2'>{{wizard.back}}</button><button class='button' type='button' data-open-passport>{{wizard.openPassport}}</button><a class='button' href='{{contact.phoneHref}}'>{{quick.contact}}</a></div>
        </section>
        <section class='professional-benefits' aria-label='Why use this calculator'><div><span><svg aria-hidden='true'><use href='/icons.svg#leaf'></use></svg></span><p><strong>Accurate solar data</strong><small>Based on PVGIS and real location</small></p></div><div><span><svg aria-hidden='true'><use href='/icons.svg#shield-check'></use></svg></span><p><strong>Your data is safe</strong><small>We don't store your personal data</small></p></div><div><span><svg aria-hidden='true'><use href='/icons.svg#faq-settings'></use></svg></span><p><strong>Professional tools</strong><small>For engineers and homeowners</small></p></div><div><span><svg aria-hidden='true'><use href='/icons.svg#support'></use></svg></span><p><strong>Expert support</strong><small>We're here to help at every step</small></p></div></section>
      </div></section>
    </div></main>
    {{> site-footer}}
    <dialog class='passport-dialog' data-passport-dialog aria-labelledby='passport-dialog-title'><form method='dialog' class='dialog-close'><button class='round-button' aria-label='{{passport.close}}'>×</button></form><div class='dialog-content'><h2 id='passport-dialog-title'>{{wizard.passportTitle}}</h2><p>{{wizard.passportCopy}}</p><div data-passport-dialog-content></div></div></dialog>
    <script id='page-config' type='application/json'>{{{pageConfig}}}</script><script type='module' src='/src/main.js'></script>
  </body>
</html>
