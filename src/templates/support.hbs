<!doctype html>
<html lang='{{locale}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='robots' content='noindex,follow' />
    <meta name='theme-color' content='#071a2d' />
    <title>{{title}} | YOURENERGY</title>
    <link rel='canonical' href='https://yourenergy.am{{path}}' />
    {{#each alternateLinks}}<link rel='alternate' hreflang='{{hreflang}}' href='{{href}}' />{{/each}}
    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' href='/yourenergy-mark.svg' type='image/svg+xml' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />
    <link rel='stylesheet' href='/src/styles/support.css' />
  </head>
  <body class='support-page'>
    <a class='skip-link' href='#main'>{{aria.skip}}</a>
    {{> site-header}}
    <main class='support-main support-main--legal' id='main'>
      <header class='legal-hero'>
        <div class='container legal-hero__inner'><p class='legal-hero__eyebrow'>{{document.eyebrow}}</p><h1 id='support-title'>{{document.title}}</h1><p class='legal-hero__updated'>{{document.updated}}</p><p class='legal-hero__intro'>{{document.intro}}</p></div>
      </header>
      <div class='container legal-content'>
        <article class='legal-document' aria-labelledby='support-title'>{{#each document.sections}}<section class='legal-section'><h2>{{title}}</h2>{{#each blocks}}{{#if heading}}<h3>{{heading}}</h3>{{/if}}{{#if text}}<p>{{text}}</p>{{/if}}{{#if lines}}<address class='legal-lines'>{{#each lines}}<span>{{this}}</span>{{/each}}</address>{{/if}}{{#if items}}<ul>{{#each items}}<li>{{this}}</li>{{/each}}</ul>{{/if}}{{/each}}</section>{{/each}}</article>
      </div>
    </main>
    {{> site-footer}}
  </body>
</html>
