{
  "name": "yourenergy-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:generate": "node --import ./scripts/register-json-loader.mjs scripts/generate-pages.mjs",
    "assets:build": "node scripts/build-images.mjs",
    "dev": "npm run content:generate -- development && vite --host 127.0.0.1",
    "prebuild": "npm run assets:build",
    "build": "npm run content:generate -- production && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./scripts/register-json-loader.mjs --test",
    "verify:build": "node scripts/verify-build.mjs",
    "screenshots:extract": "node scripts/extract-lighthouse-screenshot.mjs",
    "check": "npm test && npm run lint && npm run format:check && npm run build && npm run verify:build"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "handlebars": "^4.7.9",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "terser": "^5.51.2",
    "vite": "^8.2.2"
  }
}
