# All VITE_* values are public in the browser. Never put a provider, CRM,
# Turnstile or production credential here. The P1 browser client always calls
# same-origin /api/* Pages Functions; its provider endpoints belong in
# Cloudflare secrets, documented in functions/README.md.

# Public OpenStreetMap fallback for the manual property/roof map. It is used
# only after the visitor starts the map workflow and must retain attribution.
# Replace it only with an approved HTTPS tile URL; the build adds its origin to
# CSP img-src. This is presentation configuration, never a provider secret.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Reserved public same-origin URLs for the browser adapter. They must never
# contain credentials. PVGIS, geocoding, tariff and CRM provider URLs/keys are
# server-side Functions configuration, not VITE_* values.
VITE_ANALYSIS_ENDPOINT=/api/analysis
VITE_GEOCODING_ENDPOINT=/api/geocode
VITE_TARIFFS_ENDPOINT=
