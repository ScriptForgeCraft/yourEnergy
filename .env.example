# All VITE_* values are public in the browser. Never put a provider, CRM,
# Turnstile or production credential here. The P0 browser client always calls
# same-origin /api/* Pages Functions; its provider endpoints belong in
# Cloudflare secrets, documented in functions/README.md.

# Optional public map-tile presentation. Leave blank until a map provider and
# matching CSP origin have been approved; the map then displays a labelled
# no-basemap fallback rather than silently loading a public tile service.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Reserved public URLs for a future adapter only. They are intentionally not
# used by the P0 client and must never contain credentials.
VITE_ANALYSIS_ENDPOINT=/api/analysis
VITE_GEOCODING_ENDPOINT=/api/geocode
VITE_TARIFFS_ENDPOINT=
